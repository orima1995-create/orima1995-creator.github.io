<script>
  const SELECTOR = 'img[data-smart-watch-fit]';
  const SAMPLE_LIMIT = 220;

  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

  const detectDialBounds = (img) => {
    try {
      const naturalWidth = img.naturalWidth;
      const naturalHeight = img.naturalHeight;
      if (!naturalWidth || !naturalHeight) return null;

      const limit = 180;
      const ratio = Math.min(1, limit / Math.max(naturalWidth, naturalHeight));
      const width = Math.max(24, Math.round(naturalWidth * ratio));
      const height = Math.max(24, Math.round(naturalHeight * ratio));

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return null;
      ctx.drawImage(img, 0, 0, width, height);
      const data = ctx.getImageData(0, 0, width, height).data;

      const gray = new Float32Array(width * height);
      for (let i = 0; i < width * height; i++) {
        const o = i * 4;
        gray[i] = data[o] * 0.299 + data[o + 1] * 0.587 + data[o + 2] * 0.114;
      }

      const edge = new Float32Array(width * height);
      const samples = [];
      for (let y = 1; y < height - 1; y++) {
        for (let x = 1; x < width - 1; x++) {
          const i = y * width + x;
          const gx =
            -gray[(y - 1) * width + (x - 1)] - 2 * gray[y * width + (x - 1)] - gray[(y + 1) * width + (x - 1)] +
             gray[(y - 1) * width + (x + 1)] + 2 * gray[y * width + (x + 1)] + gray[(y + 1) * width + (x + 1)];
          const gy =
            -gray[(y - 1) * width + (x - 1)] - 2 * gray[(y - 1) * width + x] - gray[(y - 1) * width + (x + 1)] +
             gray[(y + 1) * width + (x - 1)] + 2 * gray[(y + 1) * width + x] + gray[(y + 1) * width + (x + 1)];
          const magnitude = Math.hypot(gx, gy);
          edge[i] = magnitude;
          if ((x + y) % 3 === 0) samples.push(magnitude);
        }
      }
      if (!samples.length) return null;
      samples.sort((a, b) => a - b);
      const threshold = samples[Math.floor(samples.length * 0.75)] || 0;

      const minDim = Math.min(width, height);
      const minRadius = Math.max(8, Math.round(minDim * 0.10));
      const maxRadius = Math.max(minRadius + 2, Math.round(minDim * 0.29));
      const centerX = width / 2;
      const centerY = height / 2;
      let best = null;

      for (let cy = Math.round(height * 0.20); cy <= height * 0.80; cy += 3) {
        for (let cx = Math.round(width * 0.20); cx <= width * 0.80; cx += 3) {
          const nx = (cx - centerX) / Math.max(1, width * 0.5);
          const ny = (cy - centerY) / Math.max(1, height * 0.5);
          const centerPrior = Math.max(0.55, 1 - Math.hypot(nx, ny) * 0.25);

          for (let radius = minRadius; radius <= maxRadius; radius += 3) {
            if (cx - radius < 2 || cx + radius >= width - 2 || cy - radius < 2 || cy + radius >= height - 2) continue;

            let sum = 0;
            let continuous = 0;
            const angleCount = 28;
            for (let k = 0; k < angleCount; k++) {
              const angle = Math.PI * 2 * k / angleCount;
              const cos = Math.cos(angle);
              const sin = Math.sin(angle);
              let strongest = 0;
              for (const delta of [-1, 0, 1]) {
                const x = Math.round(cx + (radius + delta) * cos);
                const y = Math.round(cy + (radius + delta) * sin);
                strongest = Math.max(strongest, edge[y * width + x] || 0);
              }
              sum += strongest;
              if (strongest > threshold) continuous++;
            }

            const continuity = continuous / angleCount;
            const average = sum / angleCount;
            const radiusPrior = 0.9 + 0.2 * radius / Math.max(1, maxRadius);
            const score = average * (0.35 + 0.65 * continuity) * centerPrior * radiusPrior;

            if (!best || score > best.score) {
              best = { score, cx, cy, radius, average, continuity };
            }
          }
        }
      }

      if (!best || best.continuity < 0.58 || best.average < threshold * 1.35) return null;

      // The dial is the most reliable circle. Once found, probe outward from the
      // same center for the bezel/case edge. This makes different bezel ratios
      // converge on the perceived size of the whole watch rather than only the dial.
      let framingRadius = best.radius;
      let outerBest = null;
      const outerLimit = Math.min(
        Math.round(best.radius * 1.55),
        best.cx - 2,
        width - best.cx - 3,
        best.cy - 2,
        height - best.cy - 3
      );

      for (let radius = best.radius + 3; radius <= outerLimit; radius += 2) {
        let sum = 0;
        let continuous = 0;
        const angleCount = 36;
        for (let k = 0; k < angleCount; k++) {
          const angle = Math.PI * 2 * k / angleCount;
          const cos = Math.cos(angle);
          const sin = Math.sin(angle);
          let strongest = 0;
          for (const delta of [-2, -1, 0, 1, 2]) {
            const x = Math.round(best.cx + (radius + delta) * cos);
            const y = Math.round(best.cy + (radius + delta) * sin);
            strongest = Math.max(strongest, edge[y * width + x] || 0);
          }
          sum += strongest;
          if (strongest > threshold) continuous++;
        }

        const continuity = continuous / angleCount;
        const average = sum / angleCount;
        if (continuity < 0.42 || average < threshold * 1.08) continue;

        const radiusGain = radius / best.radius;
        const score = average * (0.35 + 0.65 * continuity) * (0.92 + 0.08 * radiusGain);
        if (!outerBest || score > outerBest.score) {
          outerBest = { radius, score, continuity, average };
        }
      }

      if (outerBest && outerBest.radius >= best.radius * 1.08) {
        framingRadius = outerBest.radius;
      }

      // The case circle still needs room for crown/lugs. Keep that safety margin
      // explicit instead of blindly filling the thumbnail.
      const padFactor = framingRadius > best.radius ? 1.24 : 1.48;
      let left = best.cx - framingRadius * padFactor;
      let right = best.cx + framingRadius * padFactor;
      let top = best.cy - framingRadius * padFactor;
      let bottom = best.cy + framingRadius * padFactor;

      left = Math.max(0, left);
      right = Math.min(width, right);
      top = Math.max(0, top);
      bottom = Math.min(height, bottom);

      if (right - left < minDim * 0.18 || bottom - top < minDim * 0.18) return null;

      return {
        x: left / width,
        y: top / height,
        width: (right - left) / width,
        height: (bottom - top) / height
      };
    } catch {
      return null;
    }
  };

  const detectSubjectBounds = (img) => {
    try {
      const naturalWidth = img.naturalWidth;
      const naturalHeight = img.naturalHeight;
      if (!naturalWidth || !naturalHeight) return null;

      const ratio = Math.min(1, SAMPLE_LIMIT / Math.max(naturalWidth, naturalHeight));
      const width = Math.max(1, Math.round(naturalWidth * ratio));
      const height = Math.max(1, Math.round(naturalHeight * ratio));

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return null;
      ctx.drawImage(img, 0, 0, width, height);

      const pixels = ctx.getImageData(0, 0, width, height).data;
      const border = [];
      const pushPixel = (x, y) => {
        const offset = (y * width + x) * 4;
        border.push([
          pixels[offset],
          pixels[offset + 1],
          pixels[offset + 2],
          pixels[offset + 3]
        ]);
      };

      for (let x = 0; x < width; x += 2) {
        pushPixel(x, 0);
        if (height > 1) pushPixel(x, height - 1);
      }
      for (let y = 1; y < height - 1; y += 2) {
        pushPixel(0, y);
        if (width > 1) pushPixel(width - 1, y);
      }
      if (!border.length) return null;

      const transparentBorderRatio = border.filter(([, , , a]) => a < 32).length / border.length;
      const alphaMode = transparentBorderRatio >= 0.72;

      let bgR = 0;
      let bgG = 0;
      let bgB = 0;
      let opaqueCount = 0;
      if (!alphaMode) {
        for (const [r, g, b, a] of border) {
          if (a < 200) continue;
          bgR += r;
          bgG += g;
          bgB += b;
          opaqueCount++;
        }
        if (!opaqueCount) return null;
        bgR /= opaqueCount;
        bgG /= opaqueCount;
        bgB /= opaqueCount;
      }

      let borderVariance = 0;
      if (!alphaMode) {
        let count = 0;
        for (const [r, g, b, a] of border) {
          if (a < 200) continue;
          const dr = r - bgR;
          const dg = g - bgG;
          const db = b - bgB;
          borderVariance += (dr * dr + dg * dg + db * db) / 3;
          count++;
        }
        borderVariance = count ? Math.sqrt(borderVariance / count) : Infinity;

        // Complex scenes (wrist shots, desks, patterned backgrounds) are intentionally
        // left uncropped. Safety is more important than aggressive auto-zoom.
        if (borderVariance > 22) return null;
      }

      const distanceThreshold = Math.max(30, borderVariance * 2.4 + 18);
      const distanceThresholdSq = distanceThreshold * distanceThreshold;
      const rowCounts = new Uint16Array(height);
      const columnCounts = new Uint16Array(width);

      for (let y = 0; y < height; y++) {
        for (let x = 0; x < width; x++) {
          const offset = (y * width + x) * 4;
          const r = pixels[offset];
          const g = pixels[offset + 1];
          const b = pixels[offset + 2];
          const a = pixels[offset + 3];

          let foreground = false;
          if (alphaMode) {
            foreground = a > 40;
          } else if (a > 180) {
            const dr = r - bgR;
            const dg = g - bgG;
            const db = b - bgB;
            foreground = dr * dr + dg * dg + db * db > distanceThresholdSq;
          }

          if (foreground) {
            rowCounts[y]++;
            columnCounts[x]++;
          }
        }
      }

      const rowFloor = Math.max(2, Math.round(width * 0.015));
      const columnFloor = Math.max(2, Math.round(height * 0.015));

      let top = 0;
      while (top < height && rowCounts[top] < rowFloor) top++;
      let bottom = height - 1;
      while (bottom >= top && rowCounts[bottom] < rowFloor) bottom--;
      let left = 0;
      while (left < width && columnCounts[left] < columnFloor) left++;
      let right = width - 1;
      while (right >= left && columnCounts[right] < columnFloor) right--;

      if (right <= left || bottom <= top) return null;

      const boxWidth = right - left + 1;
      const boxHeight = bottom - top + 1;
      const coverage = (boxWidth * boxHeight) / (width * height);

      if (coverage < 0.025 || coverage > 0.92) return null;

      // If the detected subject is already touching an edge, zooming would create
      // a real risk of clipping the watch. Fall back to plain contain.
      const edgeGuardX = Math.max(1, Math.round(width * 0.012));
      const edgeGuardY = Math.max(1, Math.round(height * 0.012));
      if (
        left <= edgeGuardX ||
        top <= edgeGuardY ||
        right >= width - 1 - edgeGuardX ||
        bottom >= height - 1 - edgeGuardY
      ) return null;

      const padX = Math.max(2, Math.round(boxWidth * 0.08));
      const padY = Math.max(2, Math.round(boxHeight * 0.08));
      left = Math.max(0, left - padX);
      right = Math.min(width - 1, right + padX);
      top = Math.max(0, top - padY);
      bottom = Math.min(height - 1, bottom + padY);

      return {
        x: left / width,
        y: top / height,
        width: (right - left + 1) / width,
        height: (bottom - top + 1) / height
      };
    } catch {
      // External images may taint canvas. Never break the gallery for detection.
      return null;
    }
  };

  const parseStoredBounds = (value) => {
    if (!value) return null;
    try {
      return JSON.parse(value);
    } catch {
      return null;
    }
  };

  const applyFit = (img, bounds, safetyBounds = null) => {
    const box = img.parentElement;
    if (!box || !img.naturalWidth || !img.naturalHeight) return;

    img.style.transform = '';
    img.style.transformOrigin = '0 0';

    if (!bounds) {
      img.dataset.smartFitState = 'safe-contain';
      return;
    }

    const containerWidth = box.clientWidth;
    const containerHeight = box.clientHeight;
    if (!containerWidth || !containerHeight) return;

    const imageWidth = img.naturalWidth;
    const imageHeight = img.naturalHeight;
    const baseScale = Math.min(containerWidth / imageWidth, containerHeight / imageHeight);
    const renderedWidth = imageWidth * baseScale;
    const renderedHeight = imageHeight * baseScale;
    const imageLeft = (containerWidth - renderedWidth) / 2;
    const imageTop = (containerHeight - renderedHeight) / 2;

    const subjectLeft = imageLeft + bounds.x * imageWidth * baseScale;
    const subjectTop = imageTop + bounds.y * imageHeight * baseScale;
    const subjectWidth = bounds.width * imageWidth * baseScale;
    const subjectHeight = bounds.height * imageHeight * baseScale;

    const target = clamp(Number(img.dataset.smartFitTarget || 0.86), 0.65, 0.94);
    let maxZoom = clamp(Number(img.dataset.smartFitMax || 1.7), 1, 2.2);

    // A dial can be detected even when the surrounding scene is too complex to
    // establish the full watch bounds. In that case keep zoom conservative:
    // consistent dial size is useful, but never at the cost of obvious clipping.
    if ((img.dataset.smartFitMode || 'subject') === 'dial' && !safetyBounds) {
      maxZoom = Math.min(maxZoom, 1.45);
    }

    let safety = null;
    if (safetyBounds) {
      const left = imageLeft + safetyBounds.x * imageWidth * baseScale;
      const top = imageTop + safetyBounds.y * imageHeight * baseScale;
      const width = safetyBounds.width * imageWidth * baseScale;
      const height = safetyBounds.height * imageHeight * baseScale;
      const margin = Math.max(3, Math.min(containerWidth, containerHeight) * 0.025);
      const safeZoom = Math.min(
        (containerWidth - margin * 2) / width,
        (containerHeight - margin * 2) / height
      );
      if (Number.isFinite(safeZoom)) maxZoom = Math.min(maxZoom, Math.max(1, safeZoom));
      safety = { left, top, width, height, margin };
    }

    const desiredZoom = Math.min(
      (containerWidth * target) / subjectWidth,
      (containerHeight * target) / subjectHeight
    );
    const zoom = clamp(desiredZoom, 1, maxZoom);

    if (!Number.isFinite(zoom) || zoom < 1.06) {
      img.dataset.smartFitState = 'already-fits';
      return;
    }

    const subjectCenterX = subjectLeft + subjectWidth / 2;
    const subjectCenterY = subjectTop + subjectHeight / 2;
    let translateX = containerWidth / 2 - zoom * subjectCenterX;
    let translateY = containerHeight / 2 - zoom * subjectCenterY;

    if (safety) {
      const lowerX = safety.margin - zoom * safety.left;
      const upperX = containerWidth - safety.margin - zoom * (safety.left + safety.width);
      const lowerY = safety.margin - zoom * safety.top;
      const upperY = containerHeight - safety.margin - zoom * (safety.top + safety.height);

      if (lowerX <= upperX) translateX = clamp(translateX, lowerX, upperX);
      if (lowerY <= upperY) translateY = clamp(translateY, lowerY, upperY);
    }

    img.style.transform = `matrix(${zoom},0,0,${zoom},${translateX},${translateY})`;
    img.dataset.smartFitState = safety ? 'auto-framed-safe' : 'auto-framed-conservative';
  };

  const prepare = (img) => {
    if (!(img instanceof HTMLImageElement)) return;

    const run = () => {
      if (!img.dataset.smartFitBoundsChecked) {
        const mode = img.dataset.smartFitMode || 'subject';
        const subjectBounds = detectSubjectBounds(img);
        const focusBounds = mode === 'dial'
          ? (detectDialBounds(img) || subjectBounds)
          : subjectBounds;

        img.dataset.smartFitBoundsChecked = '1';
        if (focusBounds) img.dataset.smartFitBounds = JSON.stringify(focusBounds);
        if (subjectBounds) img.dataset.smartFitSafetyBounds = JSON.stringify(subjectBounds);
      }

      const bounds = parseStoredBounds(img.dataset.smartFitBounds);
      const safetyBounds = parseStoredBounds(img.dataset.smartFitSafetyBounds);
      applyFit(img, bounds, safetyBounds);
    };

    if (img.complete && img.naturalWidth) run();
    else img.addEventListener('load', run, { once: true });
  };

  const init = () => document.querySelectorAll(SELECTOR).forEach(prepare);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }

  let resizeFrame = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(() => {
      document.querySelectorAll(SELECTOR).forEach((node) => {
        if (!(node instanceof HTMLImageElement)) return;
        const bounds = parseStoredBounds(node.dataset.smartFitBounds);
        const safetyBounds = parseStoredBounds(node.dataset.smartFitSafetyBounds);
        applyFit(node, bounds, safetyBounds);
      });
    });
  }, { passive: true });
</script>
