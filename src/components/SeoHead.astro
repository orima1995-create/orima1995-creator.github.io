---
interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  path = '',
  image,
  type = 'website',
  schema
} = Astro.props;

const siteRoot = 'https://orima1995-create.github.io/orima1995-creator.github.io/';
const canonical = new URL(path.replace(/^\//, ''), siteRoot).toString();
const ogImage = image
  ? (image.startsWith('http') ? image : new URL(image.replace(/^\//, ''), siteRoot).toString())
  : undefined;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
<link rel="canonical" href={canonical} />
<meta property="og:locale" content="ja_JP" />
<meta property="og:site_name" content="VINTAGE ALARM" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
<style is:inline>
  .runtime-mast-left{display:flex;align-items:center;gap:12px}
  .runtime-menu{position:relative;border:0!important}
  .runtime-menu:last-child{border-bottom:0!important}
  .runtime-menu>summary{display:grid;place-items:center;width:30px;height:30px;min-height:0;padding:0;border:1px solid var(--rule);font-family:sans-serif;font-size:18px;line-height:1;letter-spacing:0;cursor:pointer;list-style:none}
  .runtime-menu>summary::after{content:none!important}
  .runtime-menu-panel{position:absolute;z-index:50;top:38px;left:0;width:min(78vw,280px);padding:9px;border:1px solid var(--ink);background:var(--paper);box-shadow:0 16px 38px rgba(36,31,26,.14)}
  .runtime-menu-panel a{display:flex;justify-content:space-between;gap:18px;padding:13px 11px;border-bottom:1px solid var(--rule);color:var(--ink);font-size:13px;letter-spacing:.04em;text-decoration:none;white-space:normal}
  .runtime-menu-panel a:last-child{border-bottom:0}
  .runtime-menu-panel a::after{content:'→';font-family:Georgia,"Times New Roman",serif}
  @media(max-width:480px){
    .runtime-mast-left{gap:9px}
    .runtime-menu>summary{width:28px;height:28px;font-size:17px}
    .runtime-menu-panel{top:35px;width:min(84vw,280px)}
  }
</style>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const mast = document.querySelector('header.mast');
    if (!(mast instanceof HTMLElement)) return;
    if (mast.querySelector('.section-menu, .runtime-menu')) return;

    const base = '/orima1995-creator.github.io/';
    const menu = document.createElement('details');
    menu.className = 'runtime-menu';
    menu.innerHTML = `
      <summary aria-label="セクションメニュー">≡</summary>
      <nav class="runtime-menu-panel" aria-label="VINTAGE ALARM セクションメニュー">
        <a href="${base}history/">歴史</a>
        <a href="${base}history/#index-milestones">マイルストーン</a>
        <a href="${base}history/#index-owners">オーナーズノート</a>
        <a href="${base}history/#index-interests">調査個体</a>
      </nav>`;

    const first = mast.firstElementChild;
    const wrap = document.createElement('div');
    wrap.className = 'runtime-mast-left';
    mast.insertBefore(wrap, first);
    wrap.appendChild(menu);
    if (first) wrap.appendChild(first);
  });
</script>
