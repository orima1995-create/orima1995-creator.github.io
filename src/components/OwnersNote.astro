---
const { data, alt = "OWNER'S NOTE" } = Astro.props;
const base = import.meta.env.BASE_URL;
const resolveLocal = (path: string) => `${base}${path.replace(/^\//, '')}`;
const imageParts = (data.imageParts?.length ? data.imageParts : [data.image]).map(resolveLocal);
const zoomHref = data.zoomHref ? resolveLocal(data.zoomHref) : imageParts[0];
---
<section class="section" aria-labelledby="owners-note">
  <div class="eyebrow" id="owners-note">OWNER'S NOTE</div>
  <a class="note-link" href={zoomHref} target="_blank" rel="noopener">
    <span class="note-image-stack">
      {imageParts.map((src: string, index: number) => (
        <img src={src} alt={index === 0 ? alt : ''} loading={index === 0 ? 'eager' : 'lazy'} />
      ))}
    </span>
    <span class="zoom" aria-hidden="true">↗</span>
  </a>
  <details class="plain">
    <summary>テキストで読む</summary>
    <div class="owner-copy prose">
      <div class="owner-lead">
        {data.lead.map((line: string) => <p>{line}</p>)}
      </div>
      <h3>{data.guideTitle}</h3>
      <ul class="guide-list">
        {data.guide.map((line: string) => <li>{line}</li>)}
      </ul>
      <h3>{data.noteTitle}</h3>
      {data.note.map((paragraph: string) => <p>{paragraph}</p>)}
    </div>
  </details>
</section>

<style>
  .note-image-stack{display:block;width:100%}
  .note-image-stack img{display:block;width:100%;height:auto;margin:0}
  .note-image-stack img+img{margin-top:-1px}
</style>
