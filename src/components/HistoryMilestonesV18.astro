---
import type { HistoryCatalogEntry } from '../data/history-catalog';
const { entries, id, label } = Astro.props as { entries: HistoryCatalogEntry[]; id: string; label: string };
---
{entries.length > 0 && <section class="history-shelf-v18" id={id} aria-label={label} data-milestones>
 <header class="shelf-heading-v18"><h3>MILESTONES</h3><span>{entries.length}</span></header>
 <div class="shelf-rail-v18" tabindex="0" aria-label={label}>
  {entries.map((entry,index)=>{const topic=entry.displayTopic??'';const name=entry.displayName??entry.name;const summary=entry.displaySummary??entry.cardSummary;return <article class="shelf-card-v18" data-entry={entry.id} data-full-name={entry.name}>
   <div class="shelf-meta-v18"><time>{entry.meta.split(' / ')[0]}</time><span>{topic}</span></div>
   <h4>{name}</h4>
   <p>
    {summary}
    {entry.sourceRefs?.length > 0 && <sup class="shelf-source-refs" aria-label={`出典 ${entry.sourceRefs.join('、')}`}>{entry.sourceRefs.map((ref,refIndex)=><>{refIndex>0&&<span aria-hidden="true">,</span>}<a href={`#history-source-${ref}`}>{ref}</a></>)}</sup>}
   </p>
   <small>{index+1} / {entries.length}</small>
  </article>;})}
 </div>
</section>}