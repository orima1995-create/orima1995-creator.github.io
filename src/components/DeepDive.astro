---
const { items } = Astro.props;
const base = import.meta.env.BASE_URL;
const resolveImage = (path: string) => /^https?:\/\//.test(path)
  ? path
  : `${base}${path.replace(/^\//, '')}`;
---
<section class="section shell" aria-labelledby="deep">
  <h2 id="deep">さらに詳しく</h2>
  <div class="deep-list">
    {items.map((item: any) => {
      const images = item.images ?? [];
      const trailingImages = images.filter((image: any) =>
        !Number.isInteger(image.afterParagraph)
        || image.afterParagraph < 1
        || image.afterParagraph > item.paragraphs.length
      );

      return (
        <details>
          <summary><span class="number">{item.number}</span><span class="summary-label">{item.title}</span></summary>
          <div class="copy prose">
            {item.subtitle && <h3>{item.subtitle}</h3>}
            {item.paragraphs.map((paragraph: string, index: number) => {
              const imagesAfter = images.filter((image: any) => image.afterParagraph === index + 1);
              const refs = item.citationRefs?.[index] ?? [];
              return (
                <>
                  <p>
                    {paragraph}
                    {refs.length > 0 && (
                      <sup class="cite-refs" aria-label={`出典 ${refs.join('、')}`}>
                        {refs.map((ref: string, refIndex: number) => (
                          <>
                            {refIndex > 0 && <span aria-hidden="true">,</span>}
                            <a href={`#source-${ref}`}>{ref}</a>
                          </>
                        ))}
                      </sup>
                    )}
                  </p>
                  {imagesAfter.length > 0 && (
                    <div class="deep-media">
                      {imagesAfter.map((image: any) => (
                        <figure>
                          <img
                            src={resolveImage(image.src)}
                            alt={image.alt || image.caption || `${item.title} 補足画像`}
                            loading="lazy"
                            decoding="async"
                          />
                          {image.caption && <figcaption>{image.caption}</figcaption>}
                        </figure>
                      ))}
                    </div>
                  )}
                </>
              );
            })}
            {trailingImages.length > 0 && (
              <div class="deep-media">
                {trailingImages.map((image: any) => (
                  <figure>
                    <img
                      src={resolveImage(image.src)}
                      alt={image.alt || image.caption || `${item.title} 補足画像`}
                      loading="lazy"
                      decoding="async"
                    />
                    {image.caption && <figcaption>{image.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
            {item.linkUrl && (
              <a class="deep-link" href={item.linkUrl} target="_blank" rel="noopener">
                {item.linkLabel || '関連資料を見る'} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </details>
      );
    })}
  </div>
</section>

<style>
  .deep-media{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;margin:22px 0 28px}
  .deep-media figure{margin:0}
  .deep-media img{display:block;width:100%;height:auto;border:1px solid rgba(31,28,24,.16)}
  .deep-media figcaption{margin-top:8px;font-size:13px;line-height:1.7;opacity:.72}
  .deep-link{display:inline-flex;gap:8px;align-items:center;margin:8px 0 4px;padding-bottom:3px;border-bottom:1px solid currentColor;text-decoration:none;font-size:14px;font-weight:600;letter-spacing:.01em}
  .deep-link span{font-size:12px}
  .cite-refs{margin-left:.18em;font:600 10px/1 var(--sans, sans-serif);vertical-align:super;white-space:nowrap}
  .cite-refs a{color:var(--red,#934932);text-decoration:none;border-bottom:1px solid transparent}
  .cite-refs a:hover,.cite-refs a:focus-visible{border-bottom-color:currentColor}
  .cite-refs span{color:var(--soft,#58634e);margin:0 .08em}
  @media(max-width:480px){
    .deep-media{margin:18px 0 24px;gap:14px}
    .deep-media figcaption{font-size:12px;line-height:1.65}
  }
</style>
