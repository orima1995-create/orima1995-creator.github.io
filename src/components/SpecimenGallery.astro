---
const { items = [], title = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const resolveImage = (path: string) => /^https?:\/\//.test(path)
  ? path
  : `${base}${path.replace(/^\//, '')}`;
---
<section class="section shell specimen-gallery" aria-labelledby="specimen-gallery-title">
  <div class="specimen-gallery-head">
    <h2 id="specimen-gallery-title">掲載個体</h2>
    <span aria-hidden="true">SWIPE →</span>
  </div>
  <div class="specimen-gallery-track" role="list" aria-label={`${title} 掲載個体ギャラリー`}>
    {items.map((item: any, index: number) => (
      <figure class="specimen-gallery-card" role="listitem">
        <img
          src={resolveImage(item.image)}
          alt={item.alt || `${title} ${item.label || `掲載個体 ${index + 1}`}`}
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{item.label || `VIEW ${String(index + 1).padStart(2, '0')}`}</strong>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .specimen-gallery{overflow:hidden}
  .specimen-gallery-head{display:flex;align-items:end;justify-content:space-between;gap:16px}
  .specimen-gallery-head h2{margin-bottom:0}
  .specimen-gallery-head>span{flex:none;padding-bottom:4px;color:var(--soft,#58634e);font:600 10px/1.4 var(--sans,sans-serif);letter-spacing:.08em}
  .specimen-gallery-track{
    display:grid;
    grid-auto-flow:column;
    grid-auto-columns:minmax(0,calc((100% - 32px)/3));
    gap:16px;
    margin-top:18px;
    overflow-x:auto;
    overscroll-behavior-inline:contain;
    scroll-snap-type:x mandatory;
    scrollbar-width:thin;
    padding-bottom:12px;
    -webkit-overflow-scrolling:touch;
  }
  .specimen-gallery-card{scroll-snap-align:start;margin:0;min-width:0}
  .specimen-gallery-card img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border:1px solid rgba(31,28,24,.16);background:rgba(88,99,78,.035)}
  .specimen-gallery-card figcaption{display:grid;grid-template-columns:28px minmax(0,1fr);gap:8px;margin-top:9px;padding-top:8px;border-top:1px solid var(--rule,#bcc5b2);font-family:var(--sans,sans-serif)}
  .specimen-gallery-card figcaption span{color:var(--soft,#58634e);font-size:10px}
  .specimen-gallery-card figcaption strong{font-size:12px;line-height:1.5;font-weight:500;overflow-wrap:anywhere}
  @media(max-width:760px){
    .specimen-gallery-track{grid-auto-columns:minmax(0,82%);gap:12px;padding-right:18%}
  }
  @media(max-width:480px){
    .specimen-gallery-head>span{font-size:9px}
    .specimen-gallery-track{margin-top:14px;grid-auto-columns:minmax(0,86%);padding-right:14%}
    .specimen-gallery-card figcaption strong{font-size:11px}
  }
</style>
