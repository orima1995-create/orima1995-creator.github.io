---
import SeoHead from '../components/SeoHead.astro';
import SectionMast from '../components/SectionMast.astro';
import WatchHero from '../components/WatchHero.astro';
import OwnersNote from '../components/OwnersNote.astro';
import WatchSpec from '../components/WatchSpec.astro';
import AlarmVideo from '../components/AlarmVideo.astro';
import DeepDive from '../components/DeepDive.astro';
import Sources from '../components/Sources.astro';
import OwnerNoteEndNav from '../components/OwnerNoteEndNav.astro';
import '../styles/site.css';

const { watch } = Astro.props;
const siteRoot = 'https://orima1995-create.github.io/orima1995-creator.github.io/';
const pageTitle = watch.slug === 'pierce-duofon'
  ? 'Pierce Duofon｜Cal.135・2段階アラーム・実機音｜VINTAGE ALARM'
  : watch.slug === 'cyma-time-o-vox'
    ? 'Cyma Time-O-Vox 18K Chronomètre｜Cal.R.464・1香箱｜VINTAGE ALARM'
    : `${watch.brand} ${watch.model}｜VINTAGE ALARM`;
const description = watch.slug === 'cyma-time-o-vox'
  ? 'Cyma Time-O-Vox 18K Chronomètre。Cal.R.464、1香箱、2プッシャー、透かしラグ。OWNER\'S NOTE、SPEC、R.464機構とケース仕様のDEEP DIVEを掲載。'
  : `${watch.brand} ${watch.model}。${watch.spec.caliber}、${watch.spec.barrels}、${watch.spec.acoustic}。OWNER'S NOTE、SPEC、${watch.video ? '実機鳴動、' : ''}資料に基づくDEEP DIVEを掲載。`;
const pagePath = `${watch.slug}/`;
const pageUrl = new URL(pagePath, siteRoot).href;
const imageUrl = new URL(watch.ownersNote.image.replace(/^\//, ''), siteRoot).href;
const nextOwnerNote = watch.slug === 'pierce-duofon'
  ? { href: 'cyma-time-o-vox/owners-note/', name: 'CYMA TIME-O-VOX' }
  : watch.slug === 'cyma-time-o-vox'
    ? { href: 'pierce-duofon/#owners-note', name: 'PIERCE DUOFON' }
    : null;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: watch.slug === 'cyma-time-o-vox' ? 'CYMA TIME-O-VOX 18K CHRONOMÈTRE' : `${watch.brand} ${watch.model}`,
      description,
      inLanguage: 'ja',
      url: pageUrl,
      image: imageUrl,
      about: {
        '@type': 'Thing',
        name: `${watch.brand} ${watch.model}`
      },
      isPartOf: {
        '@type': 'WebSite',
        name: 'VINTAGE ALARM',
        url: siteRoot
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'VINTAGE ALARM',
          item: siteRoot
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: `${watch.brand} ${watch.model}`,
          item: pageUrl
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <SeoHead title={pageTitle} description={description} path={pagePath} image={watch.ownersNote.image} type="article" schema={schema} />
  </head>
  <body>
    <SectionMast rightLabel="OWNER'S NOTE" />
    <main>
      <WatchHero brand={watch.brand} model={watch.model} catchLines={watch.catch} ownerNumber={watch.ownerNumber} />
      <div class="shell owners-grid">
        <OwnersNote data={watch.ownersNote} alt={`${watch.brand} ${watch.model} OWNER'S NOTE`} />
        <WatchSpec spec={watch.spec} />
      </div>
      {watch.video && <AlarmVideo video={watch.video} title={`${watch.brand} ${watch.model}`} />}
      <DeepDive items={watch.deepDive} />
      <Sources sources={watch.sources} />
      {nextOwnerNote && (
        <OwnerNoteEndNav
          nextHref={nextOwnerNote.href}
          nextName={nextOwnerNote.name}
          historyHref="history/#1950s"
        />
      )}
    </main>
  </body>
</html>
