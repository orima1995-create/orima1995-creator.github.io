---
import SeoHead from '../components/SeoHead.astro';
import WatchHero from '../components/WatchHero.astro';
import OwnersNote from '../components/OwnersNote.astro';
import WatchSpec from '../components/WatchSpec.astro';
import AlarmVideo from '../components/AlarmVideo.astro';
import DeepDive from '../components/DeepDive.astro';
import Sources from '../components/Sources.astro';
import '../styles/site.css';

const { watch } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = watch.slug === 'pierce-duofon'
  ? 'Pierce Duofon｜Cal.135・2段階アラーム・実機音｜VINTAGE ALARM'
  : `${watch.brand} ${watch.model}｜VINTAGE ALARM`;
const description = `${watch.brand} ${watch.model}。${watch.spec.caliber}、${watch.spec.barrels}、${watch.spec.acoustic}。OWNER'S NOTE、SPEC、実機鳴動、資料に基づくDEEP DIVEを掲載。`;
const pagePath = `${watch.slug}/`;
const pageUrl = `https://orima1995-create.github.io/orima1995-creator.github.io/${watch.slug}/`;
const imageUrl = `https://orima1995-create.github.io/orima1995-creator.github.io${watch.ownersNote.image}`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: `${watch.brand} ${watch.model}`,
      description,
      inLanguage: 'ja',
      url: pageUrl,
      image: imageUrl,
      about: {
        '@type': 'Thing',
        name: `${watch.brand} ${watch.model}`
      },
      isPartOf: {
        '@type': 'WebSite',
        name: 'VINTAGE ALARM',
        url: 'https://orima1995-create.github.io/orima1995-creator.github.io/'
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'VINTAGE ALARM',
          item: 'https://orima1995-create.github.io/orima1995-creator.github.io/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: `${watch.brand} ${watch.model}`,
          item: pageUrl
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <SeoHead title={pageTitle} description={description} path={pagePath} image={watch.ownersNote.image} type="article" schema={schema} />
  </head>
  <body>
    <main>
      <WatchHero brand={watch.brand} model={watch.model} catchLines={watch.catch} ownerNumber={watch.ownerNumber} />
      <div class="shell owners-grid">
        <OwnersNote data={watch.ownersNote} />
        <WatchSpec spec={watch.spec} />
      </div>
      <AlarmVideo video={watch.video} title={`${watch.brand} ${watch.model}`} />
      <DeepDive items={watch.deepDive} />
      <Sources sources={watch.sources} />
      <nav class="shell watch-back" aria-label="歴史ページへ戻る">
        <a href={`${base}history/#1950s`}>← 1950年代のアラーム腕時計へ戻る</a>
      </nav>
    </main>
  </body>
</html>
