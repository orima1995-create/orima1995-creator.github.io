---
import SeoHead from '../../components/SeoHead.astro';
import SectionMast from '../../components/SectionMast.astro';
import { historyCatalogByGroup } from '../../data/history-catalog';
import { historyContent } from '../../data/history-content';
import ownersDirectory from '../../data/owners-directory.json';
import '../../styles/site.css';
import '../../styles/history-v5.css';

const base = import.meta.env.BASE_URL;
const milestoneCards = (era: '1910s' | '1940s' | '1950s' | '1960s' | 'electronic') =>
  historyCatalogByGroup.milestones.filter((entry) => entry.era === era && entry.featured);
const ownerCards = (era: '1940s' | '1950s') =>
  historyCatalogByGroup.owners.filter((entry) => entry.era === era && entry.featured);
const researchCards = historyCatalogByGroup.research.filter((entry) => entry.featured);

const ownerDirectoryEntry = (entryName: string) =>
  ownersDirectory.entries.find((note) => {
    const current = entryName.toUpperCase();
    const noteName = note.name.toUpperCase();
    const noteFullName = `${note.brand} ${note.name}`.toUpperCase();
    return current.includes(noteName) || noteFullName.includes(current);
  });

const hero = historyContent.hero;
const before = historyContent.before;
const era1910s = historyContent.era1910s;
const era1940s = historyContent.era1940s;
const era1950s = historyContent.era1950s;
const era1960s = historyContent.era1960s;
const electronic = historyContent.electronic;
const current = historyContent.current;
const sources = historyContent.sources;

const eraNav = [
  { href: '#before', no: '00', label: 'BEFORE' },
  { href: '#1910s', no: '01', label: '1910s' },
  { href: '#1940s', no: '02', label: '1940s' },
  { href: '#1950s', no: '03', label: '1950s' },
  { href: '#1960s', no: '04', label: '1960s' },
  { href: '#electronic', no: '05', label: '1970s' },
  { href: '#current', no: '06', label: 'CURRENT' }
] as const;

const title = 'アラーム腕時計の歴史｜Eterna・Cricket・Memovox・Duofon・Time-O-Vox｜VINTAGE ALARM';
const description = '鐘や携帯時計から、Eterna、Vulcain Cricket、Memovox、AS 1475、Pierce Duofon、Omega Memomatic、電子式アラームまで。「時間を知らせる」腕時計の歴史を辿る。';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'アラーム腕時計の歴史',
      description,
      inLanguage: 'ja',
      mainEntityOfPage: 'https://orima1995-create.github.io/orima1995-creator.github.io/history/',
      isPartOf: {
        '@type': 'WebSite',
        name: 'VINTAGE ALARM',
        url: 'https://orima1995-create.github.io/orima1995-creator.github.io/'
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'VINTAGE ALARM',
          item: 'https://orima1995-create.github.io/orima1995-creator.github.io/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'HISTORY',
          item: 'https://orima1995-create.github.io/orima1995-creator.github.io/history/'
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <SeoHead title={title} description={description} path="history/" type="article" schema={schema} />
  </head>
  <body>
    <SectionMast rightLabel="HISTORY" />

    <main>
      <section class="shell history-v5-hero">
        <div class="eyebrow">{hero.eyebrow}</div>
        <h1>HISTORY</h1>
        <p class="history-v5-title-jp">機械式アラーム腕時計の歴史</p>
        <p class="history-v5-kicker">{hero.kicker[0]}<br />{hero.kicker[1]}</p>
        <div class="history-v5-lead">
          {hero.lead.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <div class="history-v5-era-nav-wrap">
        <nav class="shell history-v5-era-nav" aria-label="歴史の年代ナビゲーション">
          {eraNav.map((item) => (
            <a href={item.href}>
              <span>{item.no}</span>
              <strong>{item.label}</strong>
            </a>
          ))}
        </nav>
      </div>

      <section class="history-v5-chapter" id="before">
        <div class="shell history-v5-chapter-inner">
          <header class="history-v5-chapter-head">
            <span class="history-v5-no">{before.chapterNo}</span>
            <div>
              <p class="history-v5-chapter-label">{before.label}</p>
              <h2>{before.title}</h2>
              <p class="history-v5-teaser">{before.teaser}</p>
            </div>
          </header>
          <div class="history-v5-body">
            <p class="history-v5-overline">{before.overline}</p>
            {before.intro.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section class="history-v5-chapter" id="1910s">
        <div class="shell history-v5-chapter-inner">
          <header class="history-v5-chapter-head">
            <span class="history-v5-no">{era1910s.chapterNo}</span>
            <div>
              <p class="history-v5-chapter-label">{era1910s.label}</p>
              <h2>{era1910s.title}</h2>
              <p class="history-v5-teaser">{era1910s.teaser}</p>
            </div>
          </header>
          <div class="history-v5-body">
            <p class="history-v5-overline">{era1910s.overline}</p>
            <p>{era1910s.intro}</p>
          </div>

          <section class="history-v5-shelf" id="milestones" aria-labelledby="milestones-1910s">
            <div class="history-v5-shelf-head"><span id="milestones-1910s">MILESTONES</span><span>1910s</span></div>
            <div class="history-v5-records">
              {milestoneCards('1910s').map((entry) => (
                <article class="history-v5-record">
                  <small>{entry.meta}</small>
                  <h3>{entry.name}</h3>
                  <div class="history-v5-record-copy">
                    <p class="history-v5-hook">{entry.hook}</p>
                    <p>{entry.cardSummary}</p>
                    <span class="history-v5-status">{entry.cardStatus}</span>
                  </div>
                </article>
              ))}
            </div>
          </section>
        </div>
      </section>

      <section class="history-v5-chapter" id="1940s">
        <div class="shell history-v5-chapter-inner">
          <header class="history-v5-chapter-head">
            <span class="history-v5-no">{era1940s.chapterNo}</span>
            <div>
              <p class="history-v5-chapter-label">{era1940s.label}</p>
              <h2>{era1940s.title}</h2>
              <p class="history-v5-teaser">{era1940s.teaser}</p>
            </div>
          </header>
          <div class="history-v5-body">
            <p class="history-v5-overline">{era1940s.overline}</p>
            <p>{era1940s.intro}</p>
          </div>

          <section class="history-v5-shelf">
            <div class="history-v5-shelf-head"><span>MILESTONES</span><span>1940s</span></div>
            <div class="history-v5-records">
              {milestoneCards('1940s').map((entry) => (
                <article class="history-v5-record">
                  <small>{entry.meta}</small>
                  <h3>{entry.name}</h3>
                  <div class="history-v5-record-copy">
                    <p class="history-v5-hook">{entry.hook}</p>
                    <p>{entry.cardSummary}</p>
                    <span class="history-v5-status">{entry.cardStatus}</span>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="history-v5-shelf">
            <div class="history-v5-shelf-head"><span>OWNER'S NOTES</span><span>FROM THE COLLECTION</span></div>
            <div class="history-v5-owner-grid">
              {ownerCards('1940s').map((entry) => {
                const note = ownerDirectoryEntry(entry.name);
                return note ? (
                  <a class="history-v5-owner-poster" href={`${base}${note.href.replace(/^\//, '')}`}>
                    <div class="history-v5-owner-poster-image">
                      <img src={`${base}${note.image.replace(/^\//, '')}`} alt="" loading="lazy" />
                    </div>
                    <div class="history-v5-owner-copy">
                      <small>{entry.meta}</small>
                      <h3>{entry.name}</h3>
                      <p>{entry.cardSummary}</p>
                      <b aria-hidden="true">→</b>
                    </div>
                  </a>
                ) : (
                  <article class="history-v5-owner-text">
                    <small>{entry.meta}</small>
                    <h3>{entry.name}</h3>
                    <p>{entry.cardSummary}</p>
                    <span class="history-v5-status">{entry.cardStatus}</span>
                  </article>
                );
              })}
            </div>
          </section>
        </div>
      </section>

      <section class="history-v5-chapter" id="1950s">
        <div class="shell history-v5-chapter-inner">
          <header class="history-v5-chapter-head">
            <span class="history-v5-no">{era1950s.chapterNo}</span>
            <div>
              <p class="history-v5-chapter-label">{era1950s.label}</p>
              <h2>{era1950s.title}</h2>
              <p class="history-v5-teaser">{era1950s.teaser}</p>
            </div>
          </header>
          <div class="history-v5-body">
            <p>{era1950s.intro}</p>
          </div>

          <section class="history-v5-shelf">
            <div class="history-v5-shelf-head"><span>MILESTONES</span><span>1950s</span></div>
            <div class="history-v5-records">
              {milestoneCards('1950s').map((entry) => (
                <article class="history-v5-record">
                  <small>{entry.meta}</small>
                  <h3>{entry.name}</h3>
                  <div class="history-v5-record-copy">
                    <p class="history-v5-hook">{entry.hook}</p>
                    <p>{entry.cardSummary}</p>
                    <span class="history-v5-status">{entry.cardStatus}</span>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="history-v5-shelf">
            <div class="history-v5-shelf-head"><span>OWNER'S NOTES</span><span>FROM THE COLLECTION</span></div>
            <div class="history-v5-owner-grid">
              {ownerCards('1950s').map((entry) => {
                const note = ownerDirectoryEntry(entry.name);
                return note ? (
                  <a class="history-v5-owner-poster" href={`${base}${note.href.replace(/^\//, '')}`}>
                    <div class="history-v5-owner-poster-image">
                      <img src={`${base}${note.image.replace(/^\//, '')}`} alt="" loading="lazy" />
                    </div>
                    <div class="history-v5-owner-copy">
                      <small>{entry.meta}</small>
                      <h3>{entry.name}</h3>
                      <p>{entry.cardSummary}</p>
                      <b aria-hidden="true">→</b>
                    </div>
                  </a>
                ) : (
                  <article class="history-v5-owner-text">
                    <small>{entry.meta}</small>
                    <h3>{entry.name}</h3>
                    <p>{entry.cardSummary}</p>
                    <span class="history-v5-status">{entry.cardStatus}</span>
                  </article>
                );
              })}
            </div>
          </section>
        </div>
      </section>

      <section class="history-v5-chapter" id="1960s">
        <div class="shell history-v5-chapter-inner">
          <header class="history-v5-chapter-head">
            <span class="history-v5-no">{era1960s.chapterNo}</span>
            <div>
              <p class="history-v5-chapter-label">{era1960s.label}</p>
              <h2>{era1960s.title}</h2>
              <p class="history-v5-teaser">{era1960s.teaser}</p>
            </div>
          </header>
          <div class="history-v5-body">
            <p>{era1960s.intro}</p>
          </div>

          <section class="history-v5-shelf">
            <div class="history-v5-shelf-head"><span>MILESTONES</span><span>1960s</span></div>
            <div class="history-v5-records">
              {milestoneCards('1960s').map((entry) => (
                <article class="history-v5-record">
                  <small>{entry.meta}</small>
                  <h3>{entry.name}</h3>
                  <div class="history-v5-record-copy">
                    <p class="history-v5-hook">{entry.hook}</p>
                    <p>{entry.cardSummary}</p>
                    <span class="history-v5-status">{entry.cardStatus}</span>
                  </div>
                </article>
              ))}
            </div>
          </section>
        </div>
      </section>

      <section class="history-v5-chapter" id="electronic">
        <div class="shell history-v5-chapter-inner">
          <header class="history-v5-chapter-head">
            <span class="history-v5-no">{electronic.chapterNo}</span>
            <div>
              <p class="history-v5-chapter-label">{electronic.label}</p>
              <h2>{electronic.title}</h2>
              <p class="history-v5-teaser">{electronic.teaser}</p>
            </div>
          </header>
          <div class="history-v5-body">
            {electronic.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <section class="history-v5-shelf">
            <div class="history-v5-shelf-head"><span>MILESTONES</span><span>1970s</span></div>
            <div class="history-v5-records">
              {milestoneCards('electronic').map((entry) => (
                <article class="history-v5-record">
                  <small>{entry.meta}</small>
                  <h3>{entry.name}</h3>
                  <div class="history-v5-record-copy">
                    <p class="history-v5-hook">{entry.hook}</p>
                    <p>{entry.cardSummary}</p>
                    <span class="history-v5-status">{entry.cardStatus}</span>
                  </div>
                </article>
              ))}
            </div>
          </section>
        </div>
      </section>

      <section class="history-v5-research" id="research">
        <div class="shell">
          <small>RESEARCH</small>
          <h2>次に気になっているものと、そのデータ。</h2>

          {researchCards.length > 0 && (
            <div class="history-v5-records">
              {researchCards.map((entry) => (
                <article class="history-v5-record">
                  <small>{entry.meta}</small>
                  <h3>{entry.name}</h3>
                  <div class="history-v5-record-copy">
                    <p class="history-v5-hook">{entry.hook}</p>
                    <p>{entry.cardSummary}</p>
                    <span class="history-v5-status">{entry.cardStatus}</span>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>

      <section class="history-v5-current" id="current">
        <div class="shell history-v5-current-inner">
          <small>{current.storyNo}</small>
          <h2>{current.title}</h2>
          <p class="history-v5-current-name">{current.name}</p>
          <a href={`${base}${current.href}`}>{current.linkLabel}</a>
        </div>
      </section>

      <section class="shell history-v5-sources">
        <details>
          <summary>{sources.summary}</summary>
          <ul>{sources.items.map((item) => <li>{item}</li>)}</ul>
        </details>
      </section>
    </main>
  </body>
</html>
