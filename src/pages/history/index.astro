---
import SeoHead from '../../components/SeoHead.astro';
import SectionMast from '../../components/SectionMast.astro';
import { historyCatalogByGroup } from '../../data/history-catalog';
import { historyContent } from '../../data/history-content';
import ownersDirectory from '../../data/owners-directory.json';
import '../../styles/site.css';
import '../../styles/history-v7.css';

const base = import.meta.env.BASE_URL;

const milestoneCards = (era: '1910s' | '1940s' | '1950s' | '1960s' | 'electronic') =>
  historyCatalogByGroup.milestones.filter((entry) => entry.era === era && entry.featured);

const ownerCards = (era: '1940s' | '1950s') =>
  historyCatalogByGroup.owners.filter((entry) => entry.era === era && entry.featured);

const ownerDirectoryEntry = (entryName: string) =>
  ownersDirectory.entries.find((note) => {
    const current = entryName.toUpperCase();
    const noteName = note.name.toUpperCase();
    const noteFullName = `${note.brand} ${note.name}`.toUpperCase();
    return current.includes(noteName) || noteFullName.includes(current);
  });

const hero = historyContent.hero;
const before = historyContent.before;
const era1910s = historyContent.era1910s;
const era1940s = historyContent.era1940s;
const era1950s = historyContent.era1950s;
const era1960s = historyContent.era1960s;
const electronic = historyContent.electronic;
const current = historyContent.current;
const sources = historyContent.sources;

const milestones1910s = milestoneCards('1910s');
const milestones1940s = milestoneCards('1940s');
const milestones1950s = milestoneCards('1950s');
const milestones1960s = milestoneCards('1960s');
const milestones1970s = milestoneCards('electronic');
const owners1940s = ownerCards('1940s');
const owners1950s = ownerCards('1950s').map((entry) => ({
  entry,
  note: ownerDirectoryEntry(entry.name)
}));

const eraNav = [
  { href: '#before', no: '00', label: 'BEFORE' },
  { href: '#1910s', no: '01', label: '1910s' },
  { href: '#1940s', no: '02', label: '1940s' },
  { href: '#1950s', no: '03', label: '1950s' },
  { href: '#1960s', no: '04', label: '1960s' },
  { href: '#electronic', no: '05', label: '1970s' },
  { href: '#current', no: '06', label: 'CURRENT' }
] as const;

const title = 'アラーム腕時計の歴史｜Eterna・Cricket・Memovox・Duofon・Time-O-Vox｜VINTAGE ALARM';
const description = '鐘や携帯時計から、Eterna、Vulcain Cricket、Memovox、AS 1475、Pierce Duofon、Omega Memomatic、電子式アラームまで。「時間を知らせる」腕時計の歴史を辿る。';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'アラーム腕時計の歴史',
      description,
      inLanguage: 'ja',
      mainEntityOfPage: 'https://orima1995-create.github.io/orima1995-creator.github.io/history/',
      isPartOf: {
        '@type': 'WebSite',
        name: 'VINTAGE ALARM',
        url: 'https://orima1995-create.github.io/orima1995-creator.github.io/'
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'VINTAGE ALARM',
          item: 'https://orima1995-create.github.io/orima1995-creator.github.io/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'HISTORY',
          item: 'https://orima1995-create.github.io/orima1995-creator.github.io/history/'
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <SeoHead title={title} description={description} path="history/" type="article" schema={schema} />
  </head>
  <body class="history-v7">
    <SectionMast rightLabel="HISTORY" />

    <main>
      <section class="shell v7-hero">
        <div class="v7-hero-top">
          <span>{hero.eyebrow}</span>
          <span>00 — 06</span>
        </div>
        <h1>HISTORY</h1>
        <p class="v7-hero-jp">機械式アラーム腕時計の歴史</p>
        <p class="v7-hero-kicker">{hero.kicker[0]}<br />{hero.kicker[1]}</p>
      </section>

      <div class="v7-era-nav-wrap">
        <nav class="shell v7-era-nav" aria-label="歴史の年代ナビゲーション">
          {eraNav.map((item) => (
            <a href={item.href}>
              <span>{item.no}</span>
              <strong>{item.label}</strong>
            </a>
          ))}
        </nav>
      </div>

      <section class="v7-era v7-before" id="before">
        <div class="shell v7-era-inner">
          <header class="v7-era-head">
            <span class="v7-era-no">{before.chapterNo}</span>
            <div>
              <p class="v7-era-label">{before.label}</p>
              <h2>{before.title}</h2>
              <p class="v7-teaser">{before.teaser}</p>
            </div>
          </header>

          <div class="v7-copy">
            <p class="v7-overline">{before.overline}</p>
            {before.intro.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section class="v7-era v7-1910s" id="1910s">
        <div class="shell v7-era-inner">
          <header class="v7-era-head">
            <span class="v7-era-no">{era1910s.chapterNo}</span>
            <div>
              <p class="v7-era-label">{era1910s.label}</p>
              <h2>{era1910s.title}</h2>
              <p class="v7-teaser">{era1910s.teaser}</p>
            </div>
          </header>

          <div class="v7-copy">
            <p class="v7-overline">{era1910s.overline}</p>
            <p>{era1910s.intro}</p>
          </div>

          <section class="v7-hero-milestone" id="milestones" aria-label="1910年代のマイルストーン">
            {milestones1910s.map((entry) => (
              <>
                <span class="v7-hero-milestone-year" aria-hidden="true">{entry.meta.slice(0, 4)}</span>
                <article class="v7-hero-milestone-content">
                  <small class="v7-meta">{entry.meta}</small>
                  <h3>{entry.name}</h3>
                  <p class="v7-hook">{entry.hook}</p>
                  <p class="v7-summary">{entry.cardSummary}</p>
                  <span class="v7-status">{entry.cardStatus}</span>
                </article>
              </>
            ))}
          </section>
        </div>
      </section>

      <section class="v7-era v7-1940s" id="1940s">
        <div class="shell v7-era-inner">
          <header class="v7-era-head">
            <span class="v7-era-no">{era1940s.chapterNo}</span>
            <div>
              <p class="v7-era-label">{era1940s.label}</p>
              <h2>{era1940s.title}</h2>
              <p class="v7-teaser">{era1940s.teaser}</p>
            </div>
          </header>

          <div class="v7-copy">
            <p class="v7-overline">{era1940s.overline}</p>
            <p>{era1940s.intro}</p>
          </div>

          <div class="v7-1940-grid">
            {milestones1940s.map((entry) => (
              <article class="v7-cricket">
                <small class="v7-meta">{entry.meta}</small>
                <h3>{entry.name}</h3>
                <p class="v7-hook">{entry.hook}</p>
                <p class="v7-summary">{entry.cardSummary}</p>
                <span class="v7-status">{entry.cardStatus}</span>
              </article>
            ))}

            {owners1940s.map((entry) => (
              <article class="v7-owner-inset">
                <small>OWNER'S NOTE / {entry.meta}</small>
                <h3>{entry.name}</h3>
                <p class="v7-hook">{entry.hook}</p>
                <p class="v7-summary">{entry.cardSummary}</p>
                <span class="v7-status">{entry.cardStatus}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="v7-era v7-1950s" id="1950s">
        <div class="shell v7-era-inner">
          <header class="v7-era-head">
            <span class="v7-era-no">{era1950s.chapterNo}</span>
            <div>
              <p class="v7-era-label">{era1950s.label}</p>
              <h2>{era1950s.title}</h2>
              <p class="v7-teaser">{era1950s.teaser}</p>
            </div>
          </header>

          <div class="v7-copy">
            <p>{era1950s.intro}</p>
          </div>

          <div class="v7-rail-label">
            <span>MILESTONES</span>
            <span>SWIPE →</span>
          </div>

          <div class="v7-milestone-rail" aria-label="1950年代のマイルストーン">
            {milestones1950s.map((entry) => (
              <article class="v7-rail-card">
                <small class="v7-meta">{entry.meta}</small>
                <h3>{entry.name}</h3>
                <p class="v7-hook">{entry.hook}</p>
                <p class="v7-summary">{entry.cardSummary}</p>
                <span class="v7-status">{entry.cardStatus}</span>
              </article>
            ))}
          </div>

          <section class="v7-owner-stage" aria-labelledby="owners-1950s">
            <div class="v7-owner-stage-head">
              <span id="owners-1950s">OWNER'S NOTES</span>
              <span>所有個体から見る。</span>
            </div>

            <div class="v7-owner-posters">
              {owners1950s.filter(({ note }) => note).map(({ entry, note }) => (
                <a class="v7-owner-poster" href={`${base}${note!.href.replace(/^\//, '')}`}>
                  <figure>
                    <img src={`${base}${note!.image.replace(/^\//, '')}`} alt="" loading="lazy" />
                    <figcaption>
                      <span>{note!.brand} {note!.name}</span>
                      <span>→</span>
                    </figcaption>
                  </figure>
                </a>
              ))}
            </div>

            <div class="v7-owner-list">
              {owners1950s.filter(({ note }) => !note).map(({ entry }) => (
                <article class="v7-owner-row">
                  <small>{entry.meta}</small>
                  <h3>{entry.name}</h3>
                  <p>{entry.cardSummary}</p>
                </article>
              ))}
            </div>
          </section>
        </div>
      </section>

      <section class="v7-era v7-1960s" id="1960s">
        <div class="shell v7-era-inner">
          <header class="v7-era-head">
            <span class="v7-era-no">{era1960s.chapterNo}</span>
            <div>
              <p class="v7-era-label">{era1960s.label}</p>
              <h2>{era1960s.title}</h2>
              <p class="v7-teaser">{era1960s.teaser}</p>
            </div>
          </header>

          <div class="v7-copy">
            <p>{era1960s.intro}</p>
          </div>

          <div class="v7-compare" aria-label="1960年代のマイルストーン">
            {milestones1960s.map((entry) => (
              <article class="v7-compare-card">
                <small class="v7-meta">{entry.meta}</small>
                <h3>{entry.name}</h3>
                <p class="v7-hook">{entry.hook}</p>
                <p class="v7-summary">{entry.cardSummary}</p>
                <span class="v7-status">{entry.cardStatus}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="v7-era v7-1970s" id="electronic">
        <div class="shell v7-era-inner">
          <header class="v7-era-head">
            <span class="v7-era-no">{electronic.chapterNo}</span>
            <div>
              <p class="v7-era-label">{electronic.label}</p>
              <h2>{electronic.title}</h2>
              <p class="v7-teaser">{electronic.teaser}</p>
            </div>
          </header>

          <div class="v7-copy">
            {electronic.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <div class="v7-transition" aria-label="1970年代の転換点">
            {milestones1970s.map((entry) => (
              <article class="v7-transition-card">
                <small class="v7-meta">{entry.meta}</small>
                <h3>{entry.name}</h3>
                <p class="v7-hook">{entry.hook}</p>
                <p class="v7-summary">{entry.cardSummary}</p>
                <span class="v7-status">{entry.cardStatus}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="v7-current" id="current">
        <div class="shell v7-current-inner">
          <small>{current.storyNo}</small>
          <h2>{current.title}</h2>
          <p class="v7-current-name">{current.name}</p>
          <a href={`${base}${current.href}`}>{current.linkLabel}</a>
        </div>
      </section>

      <aside class="v7-next" id="research" aria-label="次のリサーチ">
        <div class="shell v7-next-inner">
          <small>NEXT / RESEARCH</small>
          <div class="v7-next-line">
            <strong>次に気になっているものと、そのデータ。</strong>
            <span aria-hidden="true">→</span>
          </div>
        </div>
      </aside>

      <section class="shell v7-sources">
        <details>
          <summary>{sources.summary}</summary>
          <ul>{sources.items.map((item) => <li>{item}</li>)}</ul>
        </details>
      </section>
    </main>
  </body>
</html>
