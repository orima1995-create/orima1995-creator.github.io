---
import SeoHead from '../../components/SeoHead.astro';
import SectionMast from '../../components/SectionMast.astro';
import HistoryMilestones from '../../components/HistoryMilestones.astro';
import { historyCatalogByGroup } from '../../data/history-catalog';
import { historyContent } from '../../data/history-content';
import ownersDirectory from '../../data/owners-directory.json';
import '../../styles/site.css';
import '../../styles/history-v12.css';

const base = import.meta.env.BASE_URL;
const milestones = (era: string) => historyCatalogByGroup.milestones.filter((entry) => entry.era === era && entry.featured);
const owners = historyCatalogByGroup.owners.filter((entry) => entry.era === '1950s' && entry.featured).map((entry) => ({
  entry,
  note: ownersDirectory.entries.find((note) => entry.id === note.href.split('/')[1])
}));
const basis = historyCatalogByGroup.owners.find((entry) => entry.id === 'basis-bfg90')!;
const { before, era1910s, era1940s, era1950s, era1960s, electronic, current, sources } = historyContent;
const eras = [
  { id: 'before', no: '00', label: 'BEFORE', title: ['腕時計より前の', 'アラーム。'], paragraphs: before.intro },
  { id: '1910s', no: '01', label: '1910s', title: ['アラームを、', '腕時計のサイズへ。'], paragraphs: [era1910s.intro] },
  { id: '1940s', no: '02', label: '1940s', title: ['密閉と音量という', '矛盾を解決する。'], paragraphs: [era1940s.intro] },
  { id: '1950s', no: '03', label: '1950s', title: ['様々な需要に、', '様々な回答。'], paragraphs: [era1950s.intro] },
  { id: '1960s', no: '04', label: '1960s', title: ['用途と機構が', '広がる。'], paragraphs: [era1960s.intro] },
  { id: 'electronic', no: '05', label: '1970s', title: ['自動巻きの成熟と', '電子化。'], paragraphs: electronic.body }
];
const title = 'アラーム腕時計の歴史｜Eterna・Cricket・Memovox・Duofon・Time-O-Vox｜VINTAGE ALARM';
const description = '鐘や携帯時計から、Eterna、Vulcain Cricket、Memovox、AS 1475、Pierce Duofon、Omega Memomatic、電子式アラームまで。「時間を知らせる」腕時計の歴史を辿る。';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: 'アラーム腕時計の歴史', description, inLanguage: 'ja', mainEntityOfPage: 'https://orima1995-create.github.io/orima1995-creator.github.io/history/', isPartOf: { '@type': 'WebSite', name: 'VINTAGE ALARM', url: 'https://orima1995-create.github.io/orima1995-creator.github.io/' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VINTAGE ALARM', item: 'https://orima1995-create.github.io/orima1995-creator.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'HISTORY', item: 'https://orima1995-create.github.io/orima1995-creator.github.io/history/' }
    ] }
  ]
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171918" />
    <link rel="icon" href="data:," />
    <SeoHead title={title} description={description} path="history/" type="article" schema={schema} />
  </head>
  <body class="history-v12">
    <div class="history-mast"><SectionMast rightLabel="HISTORY" /></div>
    <main>
      <section class="history-cover" aria-labelledby="history-title">
        <div class="shell">
          <div class="cover-meta"><span>ALARM WRISTWATCHES</span><span>16C — CURRENT</span></div>
          <h1 id="history-title">HISTORY<span>アラーム腕時計の歴史</span></h1>
          <div class="cover-footer">
            <p>時刻を見るだけではなく、<br />設定した時刻を知らせる。</p>
            <a href="#before" aria-label="歴史を読み始める">↓</a>
          </div>
        </div>
      </section>
      <nav class="shell history-nav" aria-label="歴史の年代ナビゲーション">
        {eras.map((era) => <a href={`#${era.id}`}><span>{era.no}</span>{era.label}</a>)}
        <a href="#current"><span>06</span>CURRENT</a>
      </nav>
      {eras.map((era) => (
        <section class="chronology-era" id={era.id}>
          <div class="shell">
            <div class="era-story">
              <header>
                <p class="era-label"><span>{era.no}</span>{era.id === 'before' ? 'BEFORE THE WRIST' : era.label}</p>
                <h2>{era.title.map((line) => <span>{line}</span>)}</h2>
              </header>
              <div class="era-copy">{era.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
            </div>
            {era.id !== 'before' && <HistoryMilestones entries={milestones(era.id)} id={era.id === '1910s' ? 'milestones' : `milestones-${era.id}`} label={`${era.label}のマイルストーン`} />}
            {era.id === '1940s' && (
              <div class="basis-record"><small>COLLECTION INDEX</small><strong>{basis.name}</strong><p>{basis.hook}</p></div>
            )}
            {era.id === '1950s' && (
              <section class="owner-section" aria-labelledby="owner-title">
                <div class="owner-heading"><h3 id="owner-title">OWNER'S NOTES</h3><p>所有個体から見る。</p></div>
                <div class="owner-documents">
                  {owners.map(({ entry, note }) => note && (
                    <a href={`${base}${note.href.replace(/^\//, '')}`} class="owner-document">
                      <figure>
                        <div class="owner-original"><img src={`${base}${note.image.replace(/^\//, '')}`} alt="" loading="lazy" width={entry.id === 'pierce-duofon' ? 1179 : 1063} height={entry.id === 'pierce-duofon' ? 1646 : 1479} /></div>
                        <figcaption><strong>{entry.id === 'cyma-time-o-vox' ? 'CYMA TIME-O-VOX' : entry.name}</strong><span aria-hidden="true">↗</span></figcaption>
                      </figure>
                    </a>
                  ))}
                </div>
                <div class="collection-index"><small>COLLECTION INDEX</small><div>{owners.map(({ entry, note }) => !note && <span>{entry.name}</span>)}</div></div>
              </section>
            )}
          </div>
        </section>
      ))}
      <section class="history-current shell" id="current">
        <div><p class="era-label"><span>06</span>CURRENT</p><h2>{current.title}</h2></div>
        <a href={`${base}${current.href}`}><span>{current.name}</span><small>見る <b aria-hidden="true">↗</b></small></a>
      </section>
      <aside class="history-research shell" id="research" aria-label="次のリサーチ">
        <h2>RESEARCH</h2><p>次に気になっているものと、<wbr />そのデータ。</p>
      </aside>
      <section class="history-sources shell"><details><summary>{sources.summary}</summary><ul>{sources.items.map((item) => <li>{item}</li>)}</ul></details></section>
    </main>
  </body>
</html>
