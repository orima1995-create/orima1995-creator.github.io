---
import SeoHead from '../../components/SeoHead.astro';
import SectionMast from '../../components/SectionMast.astro';
import HistoryMilestones from '../../components/HistoryMilestonesV18.astro';
import OwnerThumbnailFrame from '../../components/OwnerThumbnailFrame.astro';
import { historyCatalogByGroup } from '../../data/history-catalog';
import { historyContent } from '../../data/history-content';
import ownersDirectory from '../../data/owners-directory.json';
import '../../styles/site.css';
import '../../styles/history-v13.css';
import '../../styles/history-v18.css';
const base=import.meta.env.BASE_URL;
const jaSegmenter=new Intl.Segmenter('ja',{granularity:'word'});
const jaParticles=/^(は|が|を|に|へ|で|と|の|も|や|か|から|まで|より|など|って|として|なら|ので|ため)$/;
const jaClosing=/^[、。！？…）」』】］〉》]+$/;
const wrapJapanese=(text:string)=>{
 const groups:string[]=[];
 for(const part of jaSegmenter.segment(text.replaceAll('\n',''))){
  const token=part.segment;
  if(!token) continue;
  if((jaParticles.test(token)||jaClosing.test(token))&&groups.length) groups[groups.length-1]+=token;
  else groups.push(token);
 }
 return groups;
};
const milestones=(era:string)=>historyCatalogByGroup.milestones.filter(entry=>entry.era===era&&entry.featured);
const ownersForEra=(era:string)=>historyCatalogByGroup.owners
 .filter(entry=>entry.era===era&&entry.featured)
 .map(entry=>{
  const note=ownersDirectory.entries.find(note=>entry.id===note.historyId||entry.id===note.href.split('/')[1]);
  const [fallbackBrand,...fallbackName]=entry.name.split(' ');
  return {
   entry,
   note,
   brand:note?.brand??fallbackBrand,
   name:note?.name??fallbackName.join(' '),
   href:note? `${base}${note.href.replace(/^\//,'')}`:undefined,
   image:note? `${base}${note.image.replace(/^\//,'')}`:undefined
  };
 });
const {hero,coverMilestones,before,era1910s,era1940s,era1950s,era1960s,electronic,current,sources}=historyContent;
const eras=[
 {id:'before',no:before.chapterNo,label:before.label,title:before.title,paragraphs:before.intro,teaser:before.teaser,motif:'images/history-motifs/before-watercolor.png',motifClass:'motif-before'},
 {id:'1910s',no:era1910s.chapterNo,label:era1910s.label,title:era1910s.title,paragraphs:[era1910s.intro],teaser:era1910s.teaser},
 {id:'1940s',no:era1940s.chapterNo,label:era1940s.label,title:era1940s.title,paragraphs:[era1940s.intro],teaser:era1940s.teaser},
 {id:'1950s',no:era1950s.chapterNo,label:era1950s.label,title:era1950s.title,paragraphs:era1950s.intro.split('\n'),teaser:era1950s.teaser,motif:'images/history-motifs/1950s-train-watercolor.png',motifClass:'motif-1950s'},
 {id:'1960s',no:era1960s.chapterNo,label:era1960s.label,title:era1960s.title,paragraphs:[era1960s.intro],teaser:era1960s.teaser,motif:'images/history-motifs/1960s-drive-watercolor.png',motifClass:'motif-1960s'},
 {id:'electronic',no:electronic.chapterNo,label:electronic.label,title:electronic.title,paragraphs:electronic.body,teaser:electronic.teaser,motif:'images/history-motifs/1970s-digital-watercolor.png',motifClass:'motif-1970s'}
];
const title='アラーム腕時計の歴史｜Eterna・Cricket・Memovox・Duofon・Time-O-Vox｜VINTAGE ALARM';
const description='鐘や携帯時計から、Eterna、Vulcain Cricket、Memovox、AS 1475、Pierce Duofon、Omega Memomatic、電子式アラームまで。「時間を知らせる」腕時計の歴史を辿る。';
const root='https://orima1995-create.github.io/orima1995-creator.github.io/';
const schema={'@context':'https://schema.org','@graph':[
 {'@type':'Article',headline:'アラーム腕時計の歴史',description,inLanguage:'ja',mainEntityOfPage:root+'history/',isPartOf:{'@type':'WebSite',name:'VINTAGE ALARM',url:root}},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'VINTAGE ALARM',item:root},{'@type':'ListItem',position:2,name:'HISTORY',item:root+'history/'}]}
]};
---
<!doctype html><html lang="ja"><head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#1c201c"/><link rel="icon" href="data:,"/>
 <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
 <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&display=swap" rel="stylesheet"/>
 <SeoHead title={title} description={description} path="history/" type="article" schema={schema}/>
</head><body class="history-v13 history-v18">
 <a class="history-skip" href="#before">本文へ</a><div class="history-mast"><SectionMast rightLabel="HISTORY"/></div>
 <main><section class="history-cover-v13" aria-labelledby="history-title"><div class="shell">
  <div class="cover-meta"><span>HISTORY</span><span>01 / CONTENTS</span></div>
  <h1 id="history-title"><span>HISTORY</span><em>of the</em><span>ALARM</span><small>WRISTWATCH</small></h1>
  <div class="cover-dates" aria-label="歴史の節目">{coverMilestones.map(item=><a href={item.href}><strong>{item.year}</strong><span>{item.line1}<br/>{item.line2}</span></a>)}</div>
  <div class="cover-foot"><p>{hero.kicker[0]}<br/>{hero.kicker[1]}</p><a href="#before" aria-label="歴史を読み始める">↓</a></div>
 </div></section>
 <nav class="history-era-nav" aria-label="歴史の年代ナビゲーション"><div class="shell">{eras.map(era=><a href={`#${era.id}`}>{era.label}</a>)}<a href="#current">CURRENT</a></div></nav>
 {eras.map(era=>{
  const eraOwners=ownersForEra(era.id);
  return <details class:list={['chronology-era','chapter-v18',{'has-owners':eraOwners.length>0,'is-before':era.id==='before','has-motif':!!era.motif}]} id={era.id} aria-labelledby={`title-${era.id}`}>
   <summary class="chapter-summary-v18">
    <span class="chapter-index-v18">{era.no}</span>
    <span class="chapter-summary-copy-v18"><small>{era.label}</small><h2 id={`title-${era.id}`}>{wrapJapanese(era.title).map(segment=><span class="ja-phrase">{segment}</span>)}</h2><span>{era.teaser}</span></span>
    {era.motif&&<img class:list={['chapter-motif-v18',era.motifClass]} src={`${base}${era.motif}`} alt="" aria-hidden="true"/>}
    <span class="chapter-toggle-v18" aria-hidden="true"><i></i></span>
   </summary>
   <div class:list={['shell','chapter-body-v18',{'has-owners-body-v18':eraOwners.length>0}]}>
    <div class="chapter-copy">{era.paragraphs.map(paragraph=><p>{wrapJapanese(paragraph).map(segment=><span class="ja-phrase">{segment}</span>)}</p>)}</div>
    {era.id!=='before'&&<HistoryMilestones entries={milestones(era.id)} id={era.id==='1910s'?'milestones':`milestones-${era.id}`} label={`${era.label}のマイルストーン`}/>}
    {eraOwners.length>0&&<aside class="history-owners" aria-label="OWNER'S NOTES">
     <div class="collection-lead"><p>所有個体から見る。</p><a href={`${base}owners-notes/`} aria-label="OWNER'S NOTES一覧">一覧 ↗</a></div>
     <div class="owner-tiles">{eraOwners.map(({note,brand,name,href,image})=><OwnerThumbnailFrame brand={brand} name={name} href={href} image={image} published={!!note}/>)}</div>
    </aside>}
   </div>
  </details>
 })}
 <section class="history-current-v13 shell" id="current" aria-labelledby="current-title"><div class="chapter-date"><strong>CURRENT</strong><span>CHAPTER 06</span></div><div><h2 id="current-title">{current.title}</h2><a class="current-link" href={`${base}${current.href}`}><span>{current.name}</span><span aria-hidden="true">↗</span></a></div></section>
 <aside class="history-research-v13 shell" id="research" aria-label="次のリサーチ"><h2>RESEARCH</h2><p>次に気になっているものと、そのデータ。</p></aside>
 <section class="history-sources-v13 shell"><details><summary>{sources.summary}</summary><ul>{sources.items.map(item=><li>{item}</li>)}</ul></details></section>
 </main>
 <script>
  const links=[...document.querySelectorAll<HTMLAnchorElement>('.history-era-nav a')];
  const chapters=[...document.querySelectorAll<HTMLDetailsElement>('details.chronology-era')];
  const sections=[...chapters,...document.querySelectorAll<HTMLElement>('#current')];
  const revealTarget=(scroll=false)=>{
   if(!location.hash)return;
   const target=document.getElementById(decodeURIComponent(location.hash.slice(1)));
   if(!target)return;
   const chapter=target.matches('details.chronology-era')?target:target.closest('details.chronology-era');
   if(chapter instanceof HTMLDetailsElement)chapter.open=true;
   if(scroll)requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));
  };
  const update=()=>{let active='';for(const section of sections)if(section.getBoundingClientRect().top<=180)active=section.id;for(const link of links){if(link.hash===`#${active}`)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');}};
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link=>link.addEventListener('click',()=>{const target=document.getElementById(decodeURIComponent(link.hash.slice(1)));const chapter=target?.matches('details.chronology-era')?target:target?.closest('details.chronology-era');if(chapter instanceof HTMLDetailsElement)chapter.open=true;}));
  let pending=false;window.addEventListener('scroll',()=>{if(!pending){pending=true;requestAnimationFrame(()=>{update();pending=false;});}},{passive:true});
  window.addEventListener('resize',update);window.addEventListener('hashchange',()=>{revealTarget(true);update();});
  chapters.forEach(chapter=>chapter.addEventListener('toggle',update));
  document.fonts.ready.then(()=>{revealTarget(!!location.hash);update();});
  document.querySelectorAll<HTMLAnchorElement>('.section-menu-panel a').forEach(link=>link.addEventListener('click',()=>link.closest('details')?.removeAttribute('open')));
 </script>
</body></html>