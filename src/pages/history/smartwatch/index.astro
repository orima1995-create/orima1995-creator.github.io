---
import SeoHead from '../../../components/SeoHead.astro';
import '../../../styles/site.css';
import '../../../styles/history-magazine.css';
const base = import.meta.env.BASE_URL;
const artwork = `${base}images/history/smartwatch.webp`;
const title = '現状の到達点：SMARTWATCH｜アラーム腕時計の歴史｜VINTAGE ALARM';
const description = 'アラーム腕時計の歴史の現在地。機械式アラームから電子化を経て、腕時計が通知・健康・通信まで扱うSMARTWATCHへ到達した先を見る。';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: '現状の到達点：SMARTWATCH',
      description,
      inLanguage: 'ja',
      image: 'https://orima1995-create.github.io/orima1995-creator.github.io/images/history/smartwatch.webp',
      url: 'https://orima1995-create.github.io/orima1995-creator.github.io/history/smartwatch/',
      isPartOf: {
        '@type': 'WebPage',
        name: 'アラーム腕時計の歴史',
        url: 'https://orima1995-create.github.io/orima1995-creator.github.io/history/'
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'VINTAGE ALARM',
          item: 'https://orima1995-create.github.io/orima1995-creator.github.io/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'HISTORY',
          item: 'https://orima1995-create.github.io/orima1995-creator.github.io/history/'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'SMARTWATCH',
          item: 'https://orima1995-create.github.io/orima1995-creator.github.io/history/smartwatch/'
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <SeoHead title={title} description={description} path="history/smartwatch/" image="https://orima1995-create.github.io/orima1995-creator.github.io/images/history/smartwatch.webp" type="article" schema={schema} />
  </head>
  <body>
    <header class="shell mast">
      <a class="mast-link" href={base}>VINTAGE ALARM</a>
      <span>HISTORY / CURRENT</span>
    </header>

    <main>
      <section class="shell smartwatch-hero">
        <div class="eyebrow">HISTORY OF ALARM WRISTWATCHES</div>
        <h1>現状の到達点。</h1>
        <p class="smartwatch-title">SMARTWATCH</p>
      </section>

      <section class="smartwatch-stage" aria-label="スマートウォッチと通知の現在">
        <a class="smartwatch-art-link" href={`${base}history/`} aria-label="アラーム腕時計の歴史に戻る">
          <img class="smartwatch-art" src={artwork} width="720" height="1080" alt="通知が過密に並ぶスマートウォッチと、もっと静かな時代へ戻るというVINTAGE ALARMのエピローグ" loading="eager" fetchpriority="high" />
        </a>
      </section>
    </main>
  </body>
</html>
