---
const title = 'COUNCIL LAB｜多視点AI議論プロトタイプ';
const description = '異なる判断軸を持つ住民を召喚し、資料やWebを参照させて議論させる検証版。';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <style>
    :root{
      --bg:#efefe8;--paper:#fafaf4;--ink:#111;--muted:#666;--line:#c8c8bb;
      --green:#008000;--blue:#0000cc;--red:#8b1f17;--meta:#e7e7df;--warn:#fff1c7;
    }
    *{box-sizing:border-box}
    html{-webkit-text-size-adjust:100%;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic",Meiryo,sans-serif;scroll-behavior:smooth}
    body{margin:0;line-height:1.65}
    button,input,textarea{font:inherit}
    button{cursor:pointer}
    a{color:var(--blue)}
    .wrap{width:min(1140px,calc(100% - 24px));margin:auto}
    header{padding:18px 0 11px;border-bottom:3px double #666;background:#e6e6df}
    .mast{display:flex;justify-content:space-between;gap:16px;align-items:end}
    .mast h1{margin:0;font:500 clamp(1.8rem,6vw,3.2rem)/1 Georgia,"Times New Roman",serif}
    .mast p{margin:6px 0 0;color:var(--muted);font-size:11px}
    .labtag{border:1px solid #777;padding:4px 7px;font-size:9px;letter-spacing:.12em;white-space:nowrap}
    main{padding:16px 0 70px}
    .notice{margin:0 0 14px;padding:9px 11px;border:1px solid #c7aa4f;background:var(--warn);font-size:11px;line-height:1.7}
    .layout{display:grid;grid-template-columns:minmax(0,350px) minmax(0,1fr);gap:15px;align-items:start}
    .panel,.thread-panel{border:1px solid #aaa99d;background:var(--paper)}
    .panel-head{padding:8px 10px;border-bottom:1px solid #aaa99d;background:#deded5;font-size:11px;font-weight:700}
    .panel-body{padding:11px}
    .field{display:block;margin-bottom:11px}
    .field>span{display:block;margin-bottom:4px;color:var(--muted);font-size:10px;font-weight:700}
    input[type="text"],input[type="url"],textarea{width:100%;border:1px solid #99998c;border-radius:0;background:#fff;padding:9px 10px;color:var(--ink)}
    textarea{min-height:105px;resize:vertical}
    .button-row,.chips{display:flex;flex-wrap:wrap;gap:6px}
    .choice,.chip{border:1px solid #99998c;background:#fff;padding:6px 8px;font-size:10px}
    .choice[aria-pressed="true"],.chip[aria-pressed="true"]{border-color:#275d31;background:#275d31;color:#fff}
    .engine-grid{display:grid;gap:7px}
    .engine{display:grid;grid-template-columns:auto 1fr;gap:8px;text-align:left;border:1px solid #aaa99d;background:#fff;padding:8px}
    .engine[aria-pressed="true"]{outline:2px solid #333;outline-offset:-2px;background:#f0f0e7}
    .engine strong{font-size:10px;white-space:nowrap}
    .engine span{color:var(--muted);font-size:9px;line-height:1.55}
    .engine-status{margin-top:8px;padding:8px 9px;border-left:3px solid #8b2019;background:#f3e8e4;font-size:9px;line-height:1.65}
    .engine-status.live{border-color:#187328;background:#e6f0e7}
    .source-row{display:grid;grid-template-columns:18px 1fr auto;gap:7px;align-items:start;padding:8px 0;border-bottom:1px dotted #c4c4b8;font-size:10px}
    .source-row:last-child{border-bottom:0}
    .source-row small{color:var(--muted)}
    .source-state{font-size:8px;color:#8b2019;white-space:nowrap}
    .source-state.live{color:#187328}
    .add-source{display:grid;grid-template-columns:1fr auto;gap:6px;margin-top:9px}
    .add-source button,.primary,.secondary{border:1px solid #222;background:#222;color:#fff;padding:9px 10px}
    .secondary{background:#fff;color:#222}
    .resident-card{padding:7px 0;border-bottom:1px dotted #c4c4b8}
    .resident-card:last-child{border-bottom:0}
    .resident-top{display:flex;justify-content:space-between;gap:8px}
    .resident-name{font-size:10px;font-weight:700}
    .resident-role,.resident-bias{color:var(--muted);font-size:9px;line-height:1.5}
    .actions{display:grid;grid-template-columns:1fr auto;gap:7px;margin-top:12px}
    .footnote{margin:10px 0 0;color:var(--muted);font-size:9px;line-height:1.6}
    details.dev{margin-top:10px;border-top:1px dotted #aaa99d;padding-top:7px}
    details.dev summary{cursor:pointer;color:var(--muted);font-size:9px}
    details.dev input{margin-top:7px;font-size:10px}

    .thread-panel{min-height:620px;background:#f5f5ef}
    .thread-head{padding:13px 12px 11px;border-bottom:1px solid #bdbdb2;background:#ecece3}
    .thread-title{margin:0;color:var(--red);font-size:18px;line-height:1.45;font-weight:700}
    .thread-meta{display:flex;flex-wrap:wrap;gap:5px 11px;margin-top:6px;color:#707069;font-size:9px}
    .thread-tools{display:flex;align-items:center;flex-wrap:wrap;gap:7px;padding:8px 10px 10px;border-bottom:1px solid #c5c5ba;background:#f0f0e9;font-size:10px}
    .thread-tools a,.thread-tools button{border:0;background:none;padding:0;color:var(--blue);text-decoration:underline;font-size:10px}
    .thread-tools .demo{margin-left:auto;color:#8b2019;text-decoration:none}
    .thread-tail{display:flex;flex-wrap:wrap;gap:8px;padding:14px 12px 16px;border-top:1px solid #bdbdb2;background:#ecece3}
    .thread-tail button{border:0;background:none;padding:0;color:var(--blue);text-decoration:underline;font-size:11px}
    .thread-tail button[disabled]{color:#888;text-decoration:none}
    .next-draft{margin:0 10px 16px;padding:12px;border:1px solid #aaa99d;background:#fff}
    .next-draft h3{margin:0 0 8px;font-size:13px;color:var(--red)}
    .next-draft label{display:block;margin:8px 0}
    .next-draft label span{display:block;margin-bottom:3px;color:#666;font-size:9px}
    .next-draft textarea{min-height:180px;font-size:13px;line-height:1.7}
    .next-draft .draft-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px}
    .next-draft .draft-actions button{border:1px solid #555;background:#fff;padding:7px 9px;font-size:10px}
    .next-draft .draft-actions .go{background:#222;color:#fff;border-color:#222}
    .thread-empty,.loading{padding:60px 20px;text-align:center;color:#777;font-size:12px}
    .loading strong{display:block;margin-bottom:7px;color:#222}

    .post{margin:0 10px;padding:15px 2px 23px;border-bottom:1px solid #d0d0c5;scroll-margin-top:14px}
    .post:target,.post.jump-target{background:#fff7cf;box-shadow:0 0 0 5px #fff7cf}
    .post-meta{font-size:12px;line-height:1.7;overflow-wrap:anywhere}
    .post-meta .no{margin-right:4px;color:var(--blue);font-weight:700;text-decoration:underline;text-underline-offset:2px}
    .post-meta .name{color:var(--green);font-weight:700}
    .post-meta .date,.post-meta .id{color:#555}
    .post-meta .id{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px}
    .post-body{margin:10px 7px 0 2em;font-size:15px;line-height:1.88;overflow-wrap:anywhere;word-break:normal}
    .post-body p{margin:0 0 14px}
    .post-body p:last-child{margin-bottom:0}
    .anchor{color:var(--blue);text-decoration:underline;cursor:pointer}
    .aa-body{margin:12px 0 0 .7em;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch}
    .aa-body pre{margin:0;font-family:"MS PGothic","ＭＳ Ｐゴシック",IPAMonaPGothic,Mona,Osaka,ui-monospace,monospace;font-size:16px;line-height:16px;letter-spacing:0;white-space:pre;color:#111}
    .post-evidence{margin:11px 7px 0 2em;color:#74746d;font-size:9px}
    .post-evidence summary{cursor:pointer;display:inline-block;color:#666;border-bottom:1px dotted #888}
    .post-evidence div{margin-top:6px;line-height:1.65}
    .post-evidence a{overflow-wrap:anywhere}
    .conclusion .name{color:#a00000}
    .back-jump{position:fixed;right:12px;bottom:20px;z-index:20;display:none;border:1px solid #555;background:#fff;padding:7px 9px;font-size:10px;box-shadow:0 2px 10px #0002}
    .back-jump.show{display:block}
    .toast{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);padding:8px 11px;background:#111;color:#fff;font-size:10px;opacity:0;pointer-events:none;transition:.18s;z-index:30}
    .toast.show{opacity:1}

    @media(max-width:760px){
      .wrap{width:min(100% - 14px,720px)}
      .layout{grid-template-columns:1fr}
      .thread-title{font-size:17px}
      .post{margin:0 6px;padding:16px 1px 25px}
      .post-meta{font-size:12px;line-height:1.78}
      .post-body{margin:11px 4px 0 1.1em;font-size:16px;line-height:1.92}
      .post-body p{margin-bottom:15px}
      .post-evidence{margin:12px 4px 0 1.1em}
      .aa-body{margin-left:0}
    }
  </style>
</head>
<body>
<header>
  <div class="wrap mast">
    <div><h1>COUNCIL LAB</h1><p>違う判断軸を、同じスレに放り込む。</p></div>
    <span class="labtag">PROTOTYPE</span>
  </div>
</header>
<main class="wrap">
  <p class="notice"><strong>個人用MVP：</strong> TypeC Project Mirrorを常時参照する前提。スレ表示・URL共有・レスアンカーは実働。AI API未接続時だけローカルデモを使い、資料やWebを読んだふりはしません。</p>
  <div class="layout">
    <div>
      <section class="panel"><div class="panel-head">1｜スレを立てる</div><div class="panel-body">
        <label class="field"><span>スレタイ</span><input id="threadTitle" type="text" value="AS 1475は本当にアラーム腕時計史のマイルストーンなのか？" /></label>
        <label class="field"><span>本文</span><textarea id="threadBody">量産数だけで歴史的重要性を決めていいのか。普及、機構、他社への影響、反証まで分けて議論して。</textarea></label>
        <div class="field"><span>議題モード</span><div class="button-row" id="modes"></div></div>
      </div></section>
      <section class="panel" style="margin-top:11px"><div class="panel-head">2｜生成エンジン</div><div class="panel-body">
        <div class="engine-grid" id="engines"></div><div class="engine-status" id="engineStatus"></div>
        <details class="dev"><summary>開発用：ENGINE API URL</summary><input id="apiEndpoint" type="url" placeholder="https://.../api/council" /></details>
      </div></section>
      <section class="panel" style="margin-top:11px"><div class="panel-head">3｜TYPEC PROJECT MIRROR</div><div class="panel-body">
        <div id="sources"></div><div class="add-source"><input id="customSource" type="url" placeholder="追加で見せたいWeb URL" /><button id="addSource" type="button">追加</button></div>
        <p class="footnote">固定資料・プロジェクトルールは毎回ON。追加URLだけ任意。非公開PDF本体・APIキーは共有URLへ埋め込まない。</p>
      </div></section>
      <section class="panel" style="margin-top:11px"><div class="panel-head">4｜住民プール</div><div class="panel-body">
        <div class="chips" id="residentChips"></div><div id="residentDetail" style="margin-top:9px"></div>
        <div class="actions"><button class="primary" id="generate" type="button">スレを立てる</button><button class="secondary" id="shuffle" type="button">住民入替</button></div>
      </div></section>
    </div>
    <section class="thread-panel" aria-live="polite"><div class="panel-head">THREAD</div><div id="thread"><div class="thread-empty">左で議題・エンジン・資料・住民を決めてスレを立てる。</div></div></section>
  </div>
</main>
<button class="back-jump" id="backJump" type="button">← 元のレスへ</button>
<div class="toast" id="toast"></div>

<script is:inline>
const MODES=[{id:'general',label:'一般'},{id:'watch',label:'時計研究'},{id:'business',label:'仕事・企画'},{id:'roast',label:'ロースト'}];
const ENGINES=[
  {id:'quick',label:'QUICK',desc:'6〜8人。短めだが、複数回の返信まで回す。'},
  {id:'project',label:'PROJECT',desc:'TypeC Project Mirror常時参照。標準は長めの議論。'},
  {id:'deep-web-10',label:'DEEP WEB ×10',desc:'10人が別々にWeb検索し、再検索と再反論を何度も行う。かなり時間がかかる。'}
];
const RESIDENTS=[
  {id:'source',name:'史料警察',role:'一次資料・文献・推論を分離',bias:'断定に厳しすぎる'},
  {id:'mechanic',name:'機構オタク',role:'構造・操作・故障から見る',bias:'機構を過大評価しがち'},
  {id:'market',name:'市場屋',role:'価格・流動性・再取得難度',bias:'価値を値札へ寄せがち'},
  {id:'historian',name:'時計史厨',role:'前後関係・同時代比較',bias:'歴史的位置づけを重く見すぎる'},
  {id:'collector',name:'沼の住人',role:'所有・再取得・実機経験',bias:'欲しい気持ちに引っ張られる'},
  {id:'editor',name:'編集者',role:'伝わる面白さと断定リスク',bias:'物語性へ寄せがち'},
  {id:'devil',name:'前提破壊班',role:'問い・前提・反証条件を疑う',bias:'否定から入りがち'},
  {id:'cfo',name:'冷徹なCFO',role:'費用対効果・機会費用',bias:'浪漫を切り捨てがち'},
  {id:'novice',name:'初見の名無しさん',role:'初見で理解できるか',bias:'専門背景が薄い'},
  {id:'researcher',name:'検索沼研究員',role:'検索語を広げ反証も拾う',bias:'調査量を増やしすぎる'},
  {id:'minimal',name:'ミニマリスト',role:'そもそも必要か',bias:'削りすぎる'},
  {id:'wild',name:'野良の変人',role:'異分野から接続する',bias:'再現性が低い'},
  {id:'aa',name:'AA職人',role:'空気をAAで切る',bias:'議論を進めない'}
];
let state={mode:'watch',engine:'project',selected:['source','mechanic','historian','market','editor','devil','researcher','wild'],sources:[
  {id:'typec-project',name:'TypeC project rules / context',kind:'Project Mirror',selected:true,connected:false,fixed:true},
  {id:'alarm-am-arm',name:'Alarm am Arm',kind:'Project PDF',selected:true,connected:false,fixed:true},
  {id:'alarm-wristwatch',name:'The Alarm Wristwatch',kind:'Project PDF',selected:true,connected:false,fixed:true},
  {id:'web',name:'Web research',kind:'Web',selected:false,connected:true,fixed:false}
],thread:null,pendingPrevious:null};
let originScroll=null;
const $=s=>document.querySelector(s);
const esc=(s='')=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const resident=id=>RESIDENTS.find(r=>r.id===id)||{id,name:id,role:'',bias:''};
const hash=s=>{let h=2166136261;for(const c of String(s)){h^=c.charCodeAt(0);h=Math.imul(h,16777619)}return (h>>>0).toString(36).slice(0,8)};
const shuffle=a=>[...a].sort(()=>Math.random()-.5);

function renderControls(){
  $('#modes').innerHTML=MODES.map(m=>`<button class="choice" data-mode="${m.id}" aria-pressed="${state.mode===m.id}">${m.label}</button>`).join('');
  document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{state.mode=b.dataset.mode;autoPick();renderControls();});
  $('#engines').innerHTML=ENGINES.map(e=>`<button class="engine" data-engine="${e.id}" aria-pressed="${state.engine===e.id}"><strong>${e.label}</strong><span>${e.desc}</span></button>`).join('');
  document.querySelectorAll('[data-engine]').forEach(b=>b.onclick=()=>{state.engine=b.dataset.engine;if(state.engine==='deep-web-10'){const w=state.sources.find(s=>s.id==='web');if(w)w.selected=true;}autoPick();renderControls();});
  const api=$('#apiEndpoint').value.trim();
  $('#engineStatus').className='engine-status'+(api?' live':'');
  $('#engineStatus').textContent=api?'ENGINE API接続先を使用。':'現在はAI API未接続。画面確認用ローカルデモ。';
  $('#sources').innerHTML=state.sources.map((s,i)=>s.fixed?`<div class="source-row"><span>●</span><span><strong>${esc(s.name)}</strong><br><small>${esc(s.kind)} / 常時ON</small></span><span class="source-state ${s.connected?'live':''}">${s.connected?'接続済':'Mirror待ち'}</span></div>`:`<label class="source-row"><input type="checkbox" data-source="${i}" ${s.selected?'checked':''}><span><strong>${esc(s.name)}</strong><br><small>${esc(s.kind)} / 任意</small></span><span class="source-state ${s.connected?'live':''}">${s.connected?'利用可':'接続待ち'}</span></label>`).join('');
  document.querySelectorAll('[data-source]').forEach(c=>c.onchange=()=>state.sources[+c.dataset.source].selected=c.checked);
  $('#residentChips').innerHTML=RESIDENTS.map(r=>`<button class="chip" data-res="${r.id}" aria-pressed="${state.selected.includes(r.id)}">${r.name}</button>`).join('');
  document.querySelectorAll('[data-res]').forEach(b=>b.onclick=()=>{const id=b.dataset.res;state.selected=state.selected.includes(id)?state.selected.filter(x=>x!==id):[...state.selected,id];renderControls();});
  $('#residentDetail').innerHTML=state.selected.map(id=>resident(id)).map(r=>`<div class="resident-card"><div class="resident-top"><span class="resident-name">${r.name}</span><span class="resident-role">${r.role}</span></div><div class="resident-bias">弱点：${r.bias}</div></div>`).join('');
}
function autoPick(){
  const core=state.mode==='watch'?['source','mechanic','historian','market','editor','devil']:state.mode==='business'?['cfo','editor','devil','novice','minimal']:state.mode==='roast'?['devil','editor','novice','wild','minimal']:['editor','devil','novice','wild','minimal'];
  const extra=shuffle(RESIDENTS.map(r=>r.id).filter(id=>!core.includes(id)&&id!=='aa')).slice(0,state.engine==='deep-web-10'?Math.max(0,10-core.length):2);
  state.selected=[...new Set([...core,...extra])].slice(0,state.engine==='deep-web-10'?10:8);
}

function topicSeed(title,body){
  const raw=`${title} ${body}`.replace(/[\n\r]/g,' ');
  return raw.length>56?raw.slice(0,56)+'…':raw;
}
function demoOpinion(r,title,body,n){
  const seed=topicSeed(title,body);
  const common=`>>1\n「${seed}」について。`;
  const map={
    source:`まず確認できる事実と評価を分けたい。資料に何が書いてあるか、後世の文献がどう位置づけたか、こちらがそこから何を推論しているかは別物。\n\nこの議題なら、単に数字や有名さを置くより「何を確認できればマイルストーンと呼べるのか」を先に定義した方がいい。反対に、その根拠が一つ崩れただけで評価が全部落ちるなら、主張自体が強すぎる。`,
    mechanic:`機構の側から見ると、重要なのは販売数だけじゃない。設計上どの問題を解いたのか、操作系や香箱構成が後続へ何を残したのかまで見ないと、普及しただけの機械と技術的な転換点を混同する。\n\n逆に革新的でも後続へ全く影響がないなら「面白い孤立例」で終わる可能性もある。俺なら構造・量産性・後続への波及を分けて採点する。`,
    historian:`歴史上の「最初」と「広めた」は別の功績だと思う。先行例があるのに普及機を世界初のように扱うのは危ない一方、最初の一個だけを唯一の転換点にするのも雑。\n\n年代順に前後の比較個体を置き、どこで市場や設計の標準が変わったかを見るべき。結論は一個のラベルより、何の意味で重要なのかを限定した方が強い。`,
    market:`市場価格は歴史的重要性の証明にはならない。ただ、流通量や長期間残った需要は「受け入れられたか」を見る補助線にはなる。\n\n希少だから高い、有名だから重要、量産だから偉い、は全部別の話。市場資料を使うなら、価格ではなく出現頻度と再取得難度、それが時代をまたいでどう変化したかまで分けたい。`,
    collector:`所有者目線だと、資料上の重要性と実機で感じる異質さがズレることがある。操作して初めて分かる設計思想や、修理時に見える弱点はカタログだけでは拾えない。\n\nただし「自分が好きだから重要」は一番危ない。実機経験は一次観察として出して、歴史評価とは別枠に置くのが妥当。`,
    editor:`記事としては「世界初」「最多」「唯一」みたいな一語に寄せるほど読みやすいけど、その瞬間に誤断定リスクが上がる。\n\n面白さを殺す必要はない。見出しは強く、本文で条件を限定する。何が確定で何が論争点かが一読で分かる構造にした方が、結果的に読者にも強い。`,
    devil:`そもそも「マイルストーン」を一軸で決める前提がおかしい可能性がある。初出、普及、技術革新、用途拡張は別軸で、同じ時計が全部を取る必要はない。\n\n反証条件を置くなら、先行例が見つかったら初出評価は落ちる、後続への影響が確認できなければ技術転換点とは呼びにくい、など。何が出たら自説を撤回するかまで決めた方が議論になる。`,
    cfo:`調査を深くするほど精度は上がるが、その情報で判断が変わるかは別。結論を変えない枝葉に時間を使うなら、先に「どの事実が判明したら採用・不採用が変わるか」を決めるべき。\n\n研究そのものが目的なら別だが、サイト掲載判断なら必要十分な証拠で止める基準も要る。`,
    novice:`初見だと「何がそれ以前と違ったのか」が分からないと重要性が伝わらない。生産数やキャリバー番号だけ並んでも、詳しくない人には数字の大きさしか残らない。\n\n一文で差分を説明して、その後に証拠を置く方が読みやすい。`,
    researcher:`検索は名称一致だけだと漏れる。ブランド、キャリバー、旧表記、広告語、特許、他言語、同時代記事へ分解して探す必要がある。\n\nしかも賛成材料だけ集めると簡単に物語が完成する。意図的に反例・先行例・同年代の競合を別検索した方がいい。`,
    minimal:`この論点を読者が本当に必要としているかから逆算したい。全部説明するより、歴史の地図を作るなら「なぜここに置いたか」が伝わる最低限の根拠で十分な場合もある。\n\n深掘りは個別ページへ逃がせる。主幹ページで全部背負う必要はない。`,
    wild:`別分野で言えば「最初に発明した規格」と「普及させた規格」と「業界標準にした規格」は別の賞を取る。時計史でも同じで、一つの王冠を奪い合うより役割別に置いた方が自然。`,
    aa:`　∧＿∧\n（　´∀｀）　＜ とりあえず「最初」と「普及」を\n（　　　　）　　 同じ箱に入れるのやめようぜ\n｜ ｜　|\n（_＿）＿）`
  };
  return {resident:r.id,text:`${common}\n\n${map[r.id]||map.wild}`,confidence:58+(n*7)%30,evidence:'ローカルデモ。実資料未参照',format:r.id==='aa'?'aa':'text'};
}
function buildDemoThread(title,body){
  const people=state.selected.map(id=>resident(id));
  const first=people.map((r,i)=>demoOpinion(r,title,body,i));
  const variants=[
    `その分け方は分かる。ただ評価軸を増やすだけだと、何でも重要個体にできてしまう。最低条件を置くべき。\n\n俺なら「後続へ何かを残した」「当時の用途を実際に広げた」のどちらかを要求する。そこまで確認できなければ、面白い個体ではあっても歴史の節目とは別扱い。`,
    `先行例があること自体は普及の功績を消さない。問題は、その後に何が変わったかを証明できるか。\n\n生産数だけでは弱いが、複数社への採用や設計の標準化まで追えれば「広めた側」のマイルストーンとしてかなり強い。`,
    `資料の厚さと主張の強さが噛み合ってない時が一番危ない。資料が薄いならコピーを弱くする、積めたら強くするでいい。\n\n反証が出た時にどの表現まで後退するかを先に決めておく方が、後付けの物語になりにくい。`,
    `>>1の問い自体を少し変えたい。「マイルストーンか」ではなく「何の意味でマイルストーンか」。初出、普及、技術、用途拡張を一つの王冠で争わせる必要がない。\n\nこの分解なら、賛成と反対が同時に成立しても矛盾しない。`,
    `ここまで読むと、強いのは単独の数字じゃなくて複数の線が交わる時だと思う。技術差分があり、流通が増え、後続にも痕跡が残る。この3つが揃えばかなり強い。\n\n逆にどれか一つしかないなら、表現は限定した方がいい。`,
    `その結論、まだ反証側が弱い。賛成材料だけで地図を作ると簡単に“重要だった物語”になる。先行例、同年代の競合、売れなかった類例まで同じ熱量で探してから決めたい。`
  ];
  const posts=[...first];
  const waveSizes=state.engine==='deep-web-10'?[10,8,6,5,4]:state.engine==='project'?[7,6,5,4]:[6,5,4];
  waveSizes.forEach((count,w)=>{
    for(let k=0;k<Math.min(count,people.length);k++){
      const r=people[(k+w+2)%people.length];
      const target=2+((k*2+w)%Math.max(1,posts.length));
      posts.push({
        resident:r.id,
        replyTo:Math.min(target,posts.length+1),
        text:variants[(k+w)%variants.length],
        confidence:60+((k*9+w*7)%31),
        evidence:'ローカルデモ。実資料未参照',
        format:r.id==='aa'?'aa':'text'
      });
    }
  });
  const conclusion={resident:'chair',text:`結論としては、「マイルストーンか否か」を一発で決めるより、何の意味で節目なのかを限定して置くのが一番強い。\n\nここまでのレスで繰り返し残ったのは、量産数・価格・世界初を単独根拠にしないこと。少なくとも先行例、技術的差分、後続への影響、実際の普及を分けて確認する必要がある。\n\n現段階では“普及上の重要候補”のような条件付き表現が妥当。先行例と後続影響まで固まれば表現を上げる。一方でHISTORY本体へ根拠を全部詰め込む必要はなく、詳細は個別ページへ逃がす余地が残る。`,confidence:79,evidence:'ローカルデモの暫定裁定',format:'text',conclusion:true};
  posts.push(conclusion);
  return {title,body,created:new Date().toISOString(),engine:state.engine,mode:state.mode,posts,demo:true,projectMirror:true};
}

function normalizeThread(t){
  if(!t)return t;
  let posts=Array.isArray(t.posts)?t.posts:[];
  if(posts.some(Array.isArray))posts=posts.flat();
  if(t.summary&&!posts.some(p=>p.conclusion||p.resident==='chair'))posts.push({resident:'chair',text:t.summary,confidence:70,evidence:'旧形式summary',conclusion:true});
  return {...t,posts};
}
function anchorify(text){
  const escaped=esc(text);
  return escaped.replace(/&gt;&gt;(\d+)(?:-(\d+))?/g,(m,a,b)=>`<a class="anchor" href="#res-${a}" data-res="${a}">${b?`&gt;&gt;${a}-${b}`:`&gt;&gt;${a}`}</a>`);
}
function paragraphs(text){return anchorify(text).split(/\n\s*\n/).map(p=>`<p>${p.replace(/\n/g,'<br>')}</p>`).join('')}
function postId(p,no){return hash(`${p.resident}-${no}-${state.thread?.title||''}`)}
function renderPost(p,no){
  const r=p.resident==='chair'?{name:'名無しさん＠議長'}:resident(p.resident);
  const date=new Date(state.thread.created||Date.now());date.setSeconds(date.getSeconds()+no*17);
  const ds=date.toLocaleString('ja-JP',{year:'numeric',month:'2-digit',day:'2-digit',weekday:'short',hour:'2-digit',minute:'2-digit',second:'2-digit'});
  const body=p.format==='aa'?`<div class="aa-body"><pre>${esc((p.replyTo?`>>${p.replyTo}\n`:'')+p.text)}</pre></div>`:`<div class="post-body">${paragraphs((p.replyTo?`>>${p.replyTo}\n\n`:'')+p.text)}</div>`;
  const citations=(p.citations||[]).map(c=>`<div><a href="${esc(c.url)}" target="_blank" rel="noopener">${esc(c.title||c.url)}</a></div>`).join('');
  const ev=`<details class="post-evidence"><summary>根拠・確信度</summary><div>${esc(p.evidence||'根拠情報なし')} / ${Number.isFinite(p.confidence)?`確信度 ${p.confidence}%`:'確信度未設定'}${citations}</div></details>`;
  return `<article class="post ${p.conclusion?'conclusion':''}" id="res-${no}" data-no="${no}"><div class="post-meta"><a class="no" href="#res-${no}">${no}</a> 名前：<span class="name">${esc(r.name)}</span> <span class="date">${esc(ds)}</span> ID:<span class="id">${postId(p,no)}</span></div>${body}${ev}</article>`;
}
function renderThread(){
  if(!state.thread){$('#thread').innerHTML='<div class="thread-empty">左で議題・エンジン・資料・住民を決めてスレを立てる。</div>';return}
  state.thread=normalizeThread(state.thread);
  const t=state.thread;
  const op={resident:'op',text:t.body||'',confidence:null,evidence:'スレ主入力',format:'text'};
  const posts=[op,...t.posts];
  const prev=t.previousThread?.title?`<span>前スレ：${esc(t.previousThread.title)}</span>`:'';
  $('#thread').innerHTML=`<div class="thread-head"><h2 class="thread-title">${esc(t.title)}</h2><div class="thread-meta"><span>${posts.length}レス</span><span>${esc(ENGINES.find(e=>e.id===t.engine)?.label||t.engine||'')}</span><span>${esc(MODES.find(m=>m.id===t.mode)?.label||t.mode||'')}</span>${prev}</div></div><div class="thread-tools"><a href="#res-1">全部</a><a href="#res-${Math.max(1,posts.length-49)}">最新50</a><a href="#res-1">1-100</a><button id="reloadThread">リロード</button><button id="shareBtn">URL共有</button>${t.demo?'<span class="demo">LOCAL DEMO</span>':''}</div>${posts.map((p,i)=>renderPost(p,i+1)).join('')}<div class="thread-tail"><button id="extendThreadBtn" type="button">このスレ続ける</button><button id="nextThreadBtn" type="button">次スレ立てる</button></div><div id="nextDraft"></div>`;
  $('#reloadThread').onclick=()=>renderThread();$('#shareBtn').onclick=share;
  $('#extendThreadBtn').onclick=extendThread;$('#nextThreadBtn').onclick=prepareNextThread;
  document.querySelectorAll('.anchor').forEach(a=>a.addEventListener('click',onAnchor));
}
function onAnchor(e){
  const no=e.currentTarget.dataset.res;const target=document.querySelector(`#res-${no}`);if(!target)return;
  e.preventDefault();originScroll=window.scrollY;document.querySelectorAll('.jump-target').forEach(x=>x.classList.remove('jump-target'));target.classList.add('jump-target');history.pushState(null,'',`#res-${no}`);target.scrollIntoView({behavior:'smooth',block:'center'});$('#backJump').classList.add('show');
}
$('#backJump').onclick=()=>{if(originScroll!==null)window.scrollTo({top:originScroll,behavior:'smooth'});$('#backJump').classList.remove('show');originScroll=null};

function endpointFor(path){
  const api=$('#apiEndpoint').value.trim();
  if(!api)return '';
  const base=api.replace(/\/api\/council\/?$/,'').replace(/\/$/,'');
  return base+path;
}
function continuationPayload(){
  return {
    thread:state.thread,
    mode:state.mode,
    engine:state.engine,
    residents:state.selected.map(id=>resident(id)),
    sources:state.sources.filter(s=>s.selected).map(({id,name,kind})=>({id,name,kind}))
  };
}
function demoExtend(){
  if(!state.thread)return;
  const people=state.selected.map(id=>resident(id)).filter(r=>r.id!=='aa');
  const base=state.thread.posts.length+1;
  const extraTexts=[
    '>>結論まで読んだが、まだ一つ抜けている。結論を支える事実と、単にもっともらしい説明になっている部分を分け直したい。\n\n前のレスで強かった論点を一度疑い直すと、まだ確認していない比較対象が残っている。そこを潰さない限り、結論は暫定のまま。',
    '前の裁定は方向としては妥当。ただ、反証条件をもっと具体化できる。何が見つかったら結論を下げるのかを、検索可能な形に落とした方が次の調査が速い。\n\n比較個体、同年代資料、後続採用例の3系統に分ければ、同じ話を周回しにくい。',
    'ここで一回逆張りする。議論が精密になった結果、問いそのものが細かくなりすぎている可能性がある。読者にとって必要な歴史評価と、研究者向けの完全証明は別。\n\nどこまで確認できればサイト上の一文として十分か、停止条件も必要。',
    '今までのレスを読むと、残っているのは賛否ではなく証拠の優先順位だと思う。一次資料、準一次資料、後世文献、市場資料を同じ重さで置かないこと。\n\n次に掘るなら、結論を変える可能性が高い資料から当たるべき。'
  ];
  const add=[];
  for(let i=0;i<Math.min(8,people.length*2);i++){
    const r=people[i%people.length];
    const target=Math.max(2,base-1-(i%Math.min(8,base-1)));
    add.push({resident:r.id,replyTo:target,text:extraTexts[i%extraTexts.length].replace('>>結論まで','結論まで'),confidence:62+(i*5)%27,evidence:'ローカルデモ。実資料未参照',format:'text'});
  }
  const lastNo=state.thread.posts.length+add.length+1;
  add.push({resident:'chair',text:`延長後の暫定結論。前の裁定そのものは大きく崩れていないが、結論を上げるための確認事項がはっきりした。\n\n次に見るべきなのは、結論を変え得る反証資料と比較対象。ここが出なければ現状維持、出れば表現を下げる。その停止条件まで含めて判断するのが妥当。\n\nまだ未確認なのは、比較対象の網羅性と後続への影響を直接示す資料。ここを次スレで切り出す価値がある。`,confidence:80,evidence:'延長後のローカルデモ裁定',format:'text',conclusion:true});
  state.thread={...state.thread,posts:[...state.thread.posts,...add],updatedAt:new Date().toISOString(),extended:true};
}
async function extendThread(){
  if(!state.thread)return;
  const btn=$('#extendThreadBtn');if(btn){btn.disabled=true;btn.textContent='書き込み中…'}
  const url=endpointFor('/api/extend');
  if(!url){demoExtend();renderThread();return}
  try{
    const res=await fetch(url,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(continuationPayload())});
    if(!res.ok)throw new Error(await res.text());
    state.thread=normalizeThread(await res.json());renderThread();
  }catch(err){toast('延長に失敗');if(btn){btn.disabled=false;btn.textContent='このスレ続ける'}}
}
function localNextDraft(){
  const chair=[...(state.thread?.posts||[])].reverse().find(p=>p.conclusion||p.resident==='chair');
  const conclusion=chair?.text||'前スレでは暫定結論まで到達した。';
  const title=(state.thread?.title||'前スレ').replace(/[？?]$/,'')+'：未確認点を潰すスレ';
  const body=`前スレ：${state.thread?.title||''}\n\n前スレの暫定結論：\n${conclusion}\n\nまだ残っているのは、結論を変え得る反証と比較対象の確認。\nこのスレでは「何が見つかったら前スレの結論を修正するのか」を具体化して、未確認点を優先して掘る。`;
  return {title,body,previousThread:{title:state.thread?.title||'',shareId:state.thread?.shareId||null,conclusion}};
}
function showNextDraft(draft){
  const box=$('#nextDraft');if(!box)return;
  box.innerHTML=`<div class="next-draft"><h3>次スレ案</h3><label><span>スレタイ</span><input id="nextTitle" type="text" value="${esc(draft.title)}"></label><label><span>&gt;&gt;1</span><textarea id="nextBody">${esc(draft.body)}</textarea></label><div class="draft-actions"><button class="go" id="startNextThread" type="button">この内容で次スレを立てる</button><button id="cancelNextThread" type="button">やめる</button></div></div>`;
  $('#cancelNextThread').onclick=()=>box.innerHTML='';
  $('#startNextThread').onclick=async()=>{
    const title=$('#nextTitle').value.trim();const body=$('#nextBody').value.trim();
    if(!title||!body){toast('スレタイと>>1が必要');return}
    state.pendingPrevious=draft.previousThread||{title:state.thread?.title||''};
    $('#threadTitle').value=title;$('#threadBody').value=body;
    await generate();
    window.scrollTo({top:0,behavior:'smooth'});
  };
}
async function prepareNextThread(){
  if(!state.thread)return;
  const btn=$('#nextThreadBtn');if(btn){btn.disabled=true;btn.textContent='次スレ案作成中…'}
  const url=endpointFor('/api/next-thread');
  if(!url){showNextDraft(localNextDraft());if(btn){btn.disabled=false;btn.textContent='次スレ立てる'}return}
  try{
    const res=await fetch(url,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(continuationPayload())});
    if(!res.ok)throw new Error(await res.text());
    const draft=await res.json();showNextDraft(draft);
    if(btn){btn.disabled=false;btn.textContent='次スレ立てる'}
  }catch(err){toast('次スレ案の作成に失敗');if(btn){btn.disabled=false;btn.textContent='次スレ立てる'}}
}

async function generate(){
  const title=$('#threadTitle').value.trim()||'無題のスレ';const body=$('#threadBody').value.trim();const api=$('#apiEndpoint').value.trim();
  if(state.engine==='deep-web-10'&&state.selected.length<10){autoPick();renderControls()}
  $('#thread').innerHTML=`<div class="loading"><strong>${state.engine==='deep-web-10'?'10人が別々に検索中…':'住民が考え中…'}</strong>${state.engine==='deep-web-10'?'このモードはかなり時間がかかります。':'レスを組み立てています。'}</div>`;
  if(!api){state.thread=buildDemoThread(title,body);state.thread.previousThread=state.pendingPrevious||state.thread.previousThread||null;state.pendingPrevious=null;renderThread();return}
  try{
    localStorage.setItem('councilApi',api);
    const payload={title,body,mode:state.mode,engine:state.engine,residents:state.selected.map(id=>resident(id)),sources:state.sources.filter(s=>s.selected).map(({id,name,kind})=>({id,name,kind})),previousThread:state.pendingPrevious};
    const res=await fetch(api,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});if(!res.ok)throw new Error(await res.text());
    state.thread=normalizeThread(await res.json());state.pendingPrevious=null;renderThread();
  }catch(err){$('#thread').innerHTML=`<div class="thread-empty">ENGINE API error<br>${esc(err?.message||err)}</div>`}
}
function encodeState(){const p={v:3,mode:state.mode,engine:state.engine,selected:state.selected,sources:state.sources,title:$('#threadTitle').value,body:$('#threadBody').value,thread:state.thread};return btoa(unescape(encodeURIComponent(JSON.stringify(p)))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}
function decodeState(v){try{let b=v.replace(/^#s=/,'').replace(/-/g,'+').replace(/_/g,'/');while(b.length%4)b+='=';return JSON.parse(decodeURIComponent(escape(atob(b))))}catch{return null}}
function share(){const u=`${location.origin}${location.pathname}#s=${encodeState()}`;navigator.clipboard?.writeText(u);history.replaceState(null,'',`#s=${encodeState()}`);toast('共有URLをコピーしました')}
function loadShared(){if(!location.hash.startsWith('#s='))return;const p=decodeState(location.hash);if(!p)return;state.mode=p.mode||state.mode;state.engine=p.engine||state.engine;state.selected=p.selected||state.selected;const extras=(p.sources||[]).filter(x=>!['typec-project','alarm-am-arm','alarm-wristwatch'].includes(x.id));state.sources=[{id:'typec-project',name:'TypeC project rules / context',kind:'Project Mirror',selected:true,connected:false,fixed:true},{id:'alarm-am-arm',name:'Alarm am Arm',kind:'Project PDF',selected:true,connected:false,fixed:true},{id:'alarm-wristwatch',name:'The Alarm Wristwatch',kind:'Project PDF',selected:true,connected:false,fixed:true},...extras];state.thread=normalizeThread(p.thread);$('#threadTitle').value=p.title||'';$('#threadBody').value=p.body||''}
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1600)}
$('#generate').onclick=generate;$('#shuffle').onclick=()=>{autoPick();renderControls()};
$('#addSource').onclick=()=>{const v=$('#customSource').value.trim();if(!v)return;state.sources.push({id:`url-${Date.now()}`,name:v,kind:'Web URL',selected:true,connected:true});$('#customSource').value='';renderControls()};
$('#apiEndpoint').value=localStorage.getItem('councilApi')||'';$('#apiEndpoint').addEventListener('input',renderControls);
loadShared();renderControls();renderThread();
</script>
</body>
</html>
