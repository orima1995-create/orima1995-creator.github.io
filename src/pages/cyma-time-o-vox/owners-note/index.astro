---
import SectionMast from '../../../components/SectionMast.astro';
import '../../../styles/site.css';
const base = import.meta.env.BASE_URL;
const parts = [1, 2, 3, 4].map((n) => `${base}images/cyma-time-o-vox/owners-note-${n}.webp`);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#f3eee4" />
    <title>CYMA TIME-O-VOX OWNER'S NOTE｜VINTAGE ALARM</title>
  </head>
  <body>
    <SectionMast rightLabel="OWNER'S NOTE" />
    <main class="shell owner-note-zoom-page">
      <a class="owner-note-zoom-back" href={`${base}cyma-time-o-vox/`}>← CYMA TIME-O-VOX</a>
      <div class="owner-note-zoom-stack">
        {parts.map((src, index) => <img src={src} alt={index === 0 ? "CYMA TIME-O-VOX 18K CHRONOMÈTRE OWNER'S NOTE" : ''} />)}
      </div>
    </main>
  </body>
</html>

<style>
  .owner-note-zoom-page{padding:34px 0 72px}
  .owner-note-zoom-back{display:inline-block;margin-bottom:24px;padding-bottom:4px;border-bottom:1px solid currentColor;text-decoration:none;font-size:14px}
  .owner-note-zoom-stack{width:min(100%,800px);margin-inline:auto}
  .owner-note-zoom-stack img{display:block;width:100%;height:auto;margin:0}
  .owner-note-zoom-stack img+img{margin-top:-1px}
  @media(max-width:480px){
    .owner-note-zoom-page{padding-top:24px}
    .owner-note-zoom-back{margin-bottom:18px}
  }
</style>
