---
import SeoHead from '../../components/SeoHead.astro';
import SectionMast from '../../components/SectionMast.astro';
import ownersDirectory from '../../data/owners-directory.json';
import '../../styles/site.css';

const base = import.meta.env.BASE_URL;
const entries = [...ownersDirectory.entries].sort((a, b) =>
  a.ownedSortYear - b.ownedSortYear || Number(a.ownerNumber) - Number(b.ownerNumber)
);
const mobileEntries = [...entries].sort((a, b) => Number(b.ownerNumber) - Number(a.ownerNumber));
const eras = [...new Set(entries.map((entry) => entry.ownedEra))];
const noteHref = (href: string) => `${base}${href.replace(/^\//, '')}`;

const title = "OWNER'S NOTES｜所有アラーム腕時計の実機記録｜VINTAGE ALARM";
const description = "VINTAGE ALARMのOWNER'S NOTE一覧。所有する機械式アラーム腕時計を、所有個体の年代ごとに記録する。";
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: "OWNER'S NOTES",
  description,
  inLanguage: 'ja',
  url: 'https://orima1995-create.github.io/orima1995-creator.github.io/owners-notes/'
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <SeoHead title={title} description={description} path="owners-notes/" schema={schema} />
  </head>
  <body>
    <SectionMast rightLabel="OWNER'S NOTES" />
    <main>
      <section class="shell owners-directory-hero">
        <div class="eyebrow">OWNER'S NOTES</div>
        <h1>所有個体から、読む。</h1>
      </section>

      <section class="owners-mobile" aria-label="OWNER'S NOTE一覧">
        <div class="owners-mobile-rail">
          {mobileEntries.map((entry) => (
            <a class="owners-mobile-card" href={noteHref(entry.href)} aria-label={`${entry.brand} ${entry.name} OWNER'S NOTE`}>
              <div class="owners-mobile-poster">
                <img src={`${base}${entry.image.replace(/^\//, '')}`} alt="" loading="lazy" />
              </div>
              <div class="owners-mobile-card-copy">
                <small>{entry.ownedEra} · OWNER'S NOTE / {entry.ownerNumber}</small>
                <div><strong>{entry.brand} {entry.name}</strong><span>→</span></div>
              </div>
            </a>
          ))}
        </div>
        <div class="owners-mobile-hint" aria-hidden="true"><span>SWIPE</span><span>→</span></div>
      </section>

      <section class="shell owners-directory owners-desktop" aria-label="OWNER'S NOTE年代別一覧">
        {eras.map((era) => (
          <section class="owners-era" aria-labelledby={`owners-${era}`}>
            <header class="owners-era-head">
              <h2 id={`owners-${era}`}>{era}</h2>
            </header>
            <div class="owners-era-grid">
              {entries.filter((entry) => entry.ownedEra === era).map((entry) => (
                <a class="owners-note-card" href={noteHref(entry.href)} aria-label={`${entry.brand} ${entry.name} OWNER'S NOTE`}>
                  <img src={`${base}${entry.image.replace(/^\//, '')}`} alt="" loading="lazy" />
                  <div class="owners-note-card-copy">
                    <small>{entry.brand}</small>
                    <h3>{entry.name}</h3>
                    <p>{entry.catch}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </section>
    </main>

    <style>
      .owners-directory-hero{padding:72px 0 44px;border-bottom:1px solid var(--ink)}
      .owners-directory-hero h1{max-width:12em;margin:18px 0 0;font-size:clamp(2.2rem,6.5vw,4.4rem);font-weight:500;line-height:1.05}
      .owners-directory{padding-block:16px 86px}
      .owners-era{padding:34px 0 10px}
      .owners-era+.owners-era{border-top:1px solid var(--ink);margin-top:26px}
      .owners-era-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16px}
      .owners-era-head h2{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.9rem,4.6vw,3.1rem);font-weight:400;line-height:1}
      .owners-era-grid{display:grid;grid-template-columns:repeat(3,minmax(0,210px));gap:14px;justify-content:start}
      .owners-note-card{position:relative;display:block;width:100%;aspect-ratio:1/1;overflow:hidden;border:1px solid rgba(31,28,24,.28);background:#d9d2c5;color:#fff;text-decoration:none}
      .owners-note-card::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,13,10,.03) 34%,rgba(15,13,10,.84) 100%);pointer-events:none}
      .owners-note-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}
      .owners-note-card-copy{position:absolute;z-index:1;left:14px;right:14px;bottom:14px}
      .owners-note-card-copy small{display:block;margin-bottom:4px;font-family:Georgia,"Times New Roman",serif;font-size:8px;letter-spacing:.15em;line-height:1.3}
      .owners-note-card-copy h3{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.1rem,2.4vw,1.6rem);font-weight:400;line-height:1.08;overflow-wrap:normal;word-break:normal;line-break:strict;text-wrap:wrap}
      .owners-note-card-copy p{margin:7px 0 0;font-size:clamp(.75rem,1.5vw,.88rem);font-weight:600;line-height:1.38;overflow-wrap:normal;word-break:normal;line-break:strict;text-wrap:wrap}
      .owners-mobile{display:none}
      @media(max-width:760px){
        .owners-directory-hero{padding:50px 0 34px}
        .owners-desktop{display:none}
        .owners-mobile{display:block;padding:26px 0 62px;overflow:hidden}
        .owners-mobile-rail{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-left:16px;padding:0 16px 8px;-webkit-overflow-scrolling:touch;overscroll-behavior-inline:contain;scrollbar-width:none}
        .owners-mobile-rail::-webkit-scrollbar{display:none}
        .owners-mobile-card{flex:0 0 min(82vw,350px);overflow:hidden;border:1px solid rgba(31,28,24,.28);background:var(--paper);color:var(--ink);text-decoration:none;scroll-snap-align:start}
        .owners-mobile-poster{width:100%;background:#d9d2c5;border-bottom:1px solid var(--rule)}
        .owners-mobile-poster img{display:block;width:100%;height:auto}
        .owners-mobile-card-copy{padding:12px 14px 13px}
        .owners-mobile-card-copy small{display:block;color:var(--soft);font-family:Georgia,"Times New Roman",serif;font-size:8px;letter-spacing:.12em;line-height:1.35}
        .owners-mobile-card-copy div{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-top:7px}
        .owners-mobile-card-copy strong{min-width:0;font-family:Georgia,"Times New Roman",serif;font-size:17px;font-weight:400;line-height:1.2}
        .owners-mobile-card-copy span{flex:0 0 auto;font-family:Georgia,"Times New Roman",serif;font-size:19px}
        .owners-mobile-hint{display:flex;justify-content:space-between;padding:7px 16px 0;color:var(--soft);font-family:Georgia,"Times New Roman",serif;font-size:9px;letter-spacing:.14em}
      }
      @media(max-width:340px){
        .owners-directory-hero h1{font-size:29px;line-height:1.15}
        .owners-mobile-card{flex-basis:84vw}
      }
    </style>
  </body>
</html>
