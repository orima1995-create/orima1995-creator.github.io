---
import SeoHead from '../components/SeoHead.astro';
import SectionMast from '../components/SectionMast.astro';
import ownersDirectory from '../data/owners-directory.json';
import '../styles/site.css';
const base = import.meta.env.BASE_URL;
const ownerEntries = [...ownersDirectory.entries].sort((a, b) => Number(b.ownerNumber) - Number(a.ownerNumber));
const featured = ownerEntries[0];
const featureHref = `${base}${featured.href.replace(/^\//, '')}`;
const featureImage = `${base}${featured.image.replace(/^\//, '')}`;
const title = 'VINTAGE ALARM｜機械式アラーム腕時計の歴史・実機・資料';
const description = '機械式アラーム腕時計を、歴史・実機・音・資料から読むオンライン誌。Pierce Duofonをはじめ、各時代のアラーム腕時計と機構を整理する。';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VINTAGE ALARM',
  url: 'https://orima1995-create.github.io/orima1995-creator.github.io/',
  description,
  inLanguage: 'ja'
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <SeoHead title={title} description={description} path="" schema={schema} />
  </head>
  <body>
    <SectionMast rightLabel="ALARM WRISTWATCHES" />
    <main>
      <section class="shell home-cover">
        <div class="home-cover-title">
          <h1><span>VINTAGE</span><span>ALARM</span></h1>
          <p>アラームを、腕へ。</p>
        </div>
        <div class="home-cover-index" aria-label="VINTAGE ALARM 構成">
          <span>HISTORY</span>
          <span>OWNER'S NOTES</span>
          <span>RESEARCH</span>
        </div>
      </section>

      <section class="shell home-feature-section" aria-labelledby="home-feature-title">
        <div class="home-section-line">
          <span>OWNER'S NOTE / {featured.ownerNumber}</span>
          <a href={`${base}owners-notes/`}>ALL NOTES →</a>
        </div>
        <a class="home-feature" href={featureHref}>
          <div class="home-feature-image">
            <img src={featureImage} alt="" loading="lazy" />
          </div>
          <div class="home-feature-copy">
            <small>{featured.brand}</small>
            <h2 id="home-feature-title">{featured.name}</h2>
            <p>{featured.catch}</p>
            <span>→</span>
          </div>
        </a>
      </section>

      <section class="shell home-index-section" aria-label="VINTAGE ALARM メインコンテンツ">
        <div class="home-section-line"><span>INDEX</span></div>
        <div class="home-index-primary">
          <a href={`${base}history/`}>
            <span>01</span>
            <strong>HISTORY</strong>
            <small>鐘から現在まで。アラーム腕時計の歴史を読む</small>
            <b>→</b>
          </a>
          <a href={`${base}owners-notes/`}>
            <span>02</span>
            <strong>OWNER'S<br />NOTES</strong>
            <small>所有個体を、実機・操作・音から読む</small>
            <b>→</b>
          </a>
        </div>
        <nav class="home-index-secondary" aria-label="VINTAGE ALARM サブコンテンツ">
          <a href={`${base}history/#milestones`}><span>03</span><strong>MILESTONES</strong><b>→</b></a>
          <a href={`${base}history/#research`}><span>04</span><strong>RESEARCH</strong><b>→</b></a>
        </nav>
      </section>
    </main>

    <style>
      .home-cover{padding:88px 0 50px;border-bottom:1px solid var(--ink)}
      .home-cover-title h1{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(64px,13vw,116px);font-weight:400;line-height:.82;letter-spacing:-.025em}
      .home-cover-title h1 span{display:block}
      .home-cover-title p{margin:42px 0 0;font-size:clamp(21px,4vw,34px);letter-spacing:.05em}
      .home-cover-index{display:flex;gap:18px;margin-top:54px;padding-top:13px;border-top:1px solid var(--rule);color:var(--soft);font-family:Georgia,"Times New Roman",serif;font-size:10px;letter-spacing:.12em}
      .home-feature-section,.home-index-section{padding:54px 0 76px}
      .home-index-section{border-top:1px solid var(--ink)}
      .home-section-line{display:flex;justify-content:space-between;gap:20px;margin-bottom:16px;color:var(--soft);font-family:Georgia,"Times New Roman",serif;font-size:11px;letter-spacing:.14em}
      .home-section-line a{color:inherit;text-decoration:none}
      .home-feature{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(260px,.95fr);min-height:390px;border:1px solid var(--ink);color:inherit;text-decoration:none}
      .home-feature-image{min-height:0;overflow:hidden;background:#d8d0c2}
      .home-feature-image img{width:100%;height:100%;object-fit:cover;object-position:center top}
      .home-feature-copy{display:flex;flex-direction:column;padding:36px}
      .home-feature-copy small{font-family:Georgia,"Times New Roman",serif;font-size:11px;letter-spacing:.16em}
      .home-feature-copy h2{margin:14px 0 0;font-size:clamp(34px,5vw,56px);line-height:.95}
      .home-feature-copy p{margin:24px 0 0;color:var(--soft);font-size:17px;line-height:1.7}
      .home-feature-copy>span{margin-top:auto;align-self:flex-end;font-family:Georgia,"Times New Roman",serif;font-size:28px}
      .home-index-primary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--ink);border-left:1px solid var(--ink)}
      .home-index-primary a{display:grid;grid-template-rows:auto auto 1fr auto;min-height:280px;padding:24px;border-right:1px solid var(--ink);border-bottom:1px solid var(--ink);text-decoration:none}
      .home-index-primary span,.home-index-secondary span{color:var(--soft);font-family:Georgia,"Times New Roman",serif;font-size:12px}
      .home-index-primary strong{margin-top:26px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(29px,4vw,42px);font-weight:400;line-height:.95}
      .home-index-primary small{align-self:end;margin-top:30px;color:var(--soft);font-size:14px;line-height:1.65}
      .home-index-primary b{justify-self:end;margin-top:20px;font-family:Georgia,"Times New Roman",serif;font-size:25px;font-weight:400}
      .home-index-secondary{border-top:1px solid var(--ink)}
      .home-index-secondary a{display:grid;grid-template-columns:38px 1fr auto;gap:12px;align-items:center;min-height:66px;border-bottom:1px solid var(--ink);text-decoration:none}
      .home-index-secondary strong{font-family:Georgia,"Times New Roman",serif;font-size:18px;font-weight:400;letter-spacing:.02em}
      .home-index-secondary b{font-size:19px;font-weight:400}
      @media(max-width:480px){
        .home-cover{padding:54px 0 34px}
        .home-cover-title h1{font-size:clamp(58px,18vw,74px)}
        .home-cover-title p{margin-top:27px;font-size:20px}
        .home-cover-index{gap:11px;margin-top:38px;padding-top:10px;font-size:8px;letter-spacing:.09em}
        .home-feature-section,.home-index-section{padding:36px 0 54px}
        .home-section-line{margin-bottom:12px;font-size:9px}
        .home-feature{grid-template-columns:1fr;min-height:0}
        .home-feature-image{aspect-ratio:1/1}
        .home-feature-copy{display:grid;grid-template-columns:1fr auto;padding:18px}
        .home-feature-copy small{grid-column:1/-1;font-size:9px}
        .home-feature-copy h2{grid-column:1/-1;margin-top:9px;font-size:32px}
        .home-feature-copy p{margin-top:14px;font-size:15px;line-height:1.55}
        .home-feature-copy>span{align-self:end;font-size:24px}
        .home-index-primary{grid-template-columns:repeat(2,minmax(0,1fr))}
        .home-index-primary a{min-height:224px;padding:16px}
        .home-index-primary strong{margin-top:20px;font-size:clamp(22px,6.2vw,27px)}
        .home-index-primary small{margin-top:22px;font-size:12px;line-height:1.55}
        .home-index-primary b{margin-top:14px;font-size:21px}
        .home-index-secondary a{min-height:60px}
        .home-index-secondary strong{font-size:16px}
      }
      @media(max-width:340px){
        .home-cover-index{gap:8px;font-size:7px}
        .home-feature-copy h2{font-size:29px}
        .home-index-primary strong{font-size:20px}
        .home-index-primary small{font-size:11px}
      }
    </style>
  </body>
</html>
