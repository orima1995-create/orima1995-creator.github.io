---
import SeoHead from '../components/SeoHead.astro';
import SectionMast from '../components/SectionMast.astro';
import '../styles/site.css';
const base = import.meta.env.BASE_URL;
const title = 'VINTAGE ALARM｜機械式アラーム腕時計の歴史・実機・資料';
const description = '機械式アラーム腕時計を、歴史・実機・音・資料から読むオンライン誌。Pierce Duofonをはじめ、各時代のアラーム腕時計と機構を整理する。';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VINTAGE ALARM',
  url: 'https://orima1995-create.github.io/orima1995-creator.github.io/',
  description,
  inLanguage: 'ja'
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <SeoHead title={title} description={description} path="" schema={schema} />
  </head>
  <body>
    <SectionMast rightLabel="ALARM WRISTWATCHES" />
    <main>
      <section class="shell home-hero">
        <h1><span>VINTAGE</span><span>ALARM</span></h1>
        <p>アラームを、腕へ。</p>
      </section>

      <nav class="shell home-nav" aria-label="VINTAGE ALARM メインコンテンツ">
        <a href={`${base}history/`}>
          <span class="home-no">01</span>
          <div><strong>HISTORY</strong><small>鐘から現在まで。アラーム腕時計の歴史を読む</small></div>
          <b>→</b>
        </a>

        <a href={`${base}history/#milestones`}>
          <span class="home-no">02</span>
          <div><strong>MILESTONES</strong><small>歴史の節目になったアラーム腕時計</small></div>
          <b>→</b>
        </a>

        <a href={`${base}owners-notes/`}>
          <span class="home-no">03</span>
          <div><strong>OWNER'S NOTES</strong><small>所有個体を、実機・操作・音から読む</small></div>
          <b>→</b>
        </a>

        <a href={`${base}history/#research`}>
          <span class="home-no">04</span>
          <div><strong>RESEARCH</strong><small>気になっているもの、調査中の個体</small></div>
          <b>→</b>
        </a>
      </nav>
    </main>
  </body>
</html>
