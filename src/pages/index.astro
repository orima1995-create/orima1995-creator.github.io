---
import SeoHead from '../components/SeoHead.astro';
import SectionMast from '../components/SectionMast.astro';
import '../styles/site.css';

const base = import.meta.env.BASE_URL;
const title = 'VINTAGE ALARM｜機械式アラーム腕時計の歴史・実機・資料';
const description = '機械式アラーム腕時計を、歴史・実機・音・資料から読むオンライン誌。Pierce Duofonをはじめ、各時代のアラーム腕時計と機構を整理する。';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VINTAGE ALARM',
  url: 'https://orima1995-create.github.io/orima1995-creator.github.io/',
  description,
  inLanguage: 'ja'
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171410" />
    <SeoHead title={title} description={description} path="" schema={schema} />
  </head>
  <body class="home-v3">
    <SectionMast rightLabel="ALARM WRISTWATCH ARCHIVE" />

    <main>
      <section class="home-v3-cover" aria-labelledby="home-v3-title">
        <div class="home-v3-photo-placeholder" aria-hidden="true">
          <span>COLLECTION PHOTOGRAPH / TEMP</span>
        </div>

        <div class="shell home-v3-cover-inner">
          <div class="home-v3-cover-copy">
            <h1 id="home-v3-title"><span>VINTAGE</span><span>ALARM</span></h1>
            <p>アラームを、腕へ。</p>
          </div>
          <div class="home-v3-scroll" aria-hidden="true"><span>SCROLL</span><b>↓</b></div>
        </div>
      </section>

      <section class="shell home-v3-intro" aria-label="VINTAGE ALARMについて">
        <small>MECHANICAL ALARM WRISTWATCH ARCHIVE</small>
        <p>機械式アラーム腕時計を、<br />実機・音・資料から読む。</p>
      </section>

      <section class="home-v3-history-band">
        <div class="shell">
          <a class="home-v3-history" href={`${base}history/`}>
            <span class="home-v3-no">01</span>
            <div>
              <small>ENTER</small>
              <h2>HISTORY</h2>
              <p>鐘から現在まで。アラーム腕時計の歴史を読む</p>
            </div>
            <b aria-hidden="true">→</b>
          </a>
        </div>
      </section>

      <section class="shell home-v3-secondary">
        <a href={`${base}history/#research`}>
          <span class="home-v3-no">02</span>
          <div>
            <small>RESEARCH</small>
            <p>気になっているもの、調査中の個体</p>
          </div>
          <b aria-hidden="true">→</b>
        </a>
      </section>
    </main>

    <style>
      .home-v3-cover{
        position:relative;
        min-height:calc(100svh - 64px);
        overflow:hidden;
        background:#171410;
        color:#eee9df;
      }
      .home-v3-photo-placeholder{
        position:absolute;
        inset:0;
        background:
          radial-gradient(circle at 22% 26%,rgba(174,145,106,.16),transparent 24%),
          radial-gradient(circle at 78% 62%,rgba(116,94,70,.14),transparent 26%),
          linear-gradient(145deg,#211d18 0%,#12100d 58%,#090807 100%);
      }
      .home-v3-photo-placeholder::before,
      .home-v3-photo-placeholder::after{
        content:"";
        position:absolute;
        border:1px solid rgba(238,233,223,.10);
        transform:rotate(-17deg);
      }
      .home-v3-photo-placeholder::before{
        width:56%;
        aspect-ratio:1/1.35;
        left:-7%;
        top:12%;
      }
      .home-v3-photo-placeholder::after{
        width:42%;
        aspect-ratio:1/1.45;
        right:-8%;
        bottom:8%;
        transform:rotate(16deg);
      }
      .home-v3-photo-placeholder>span{
        position:absolute;
        top:24px;
        left:50%;
        transform:translateX(-50%);
        width:max-content;
        max-width:80%;
        color:rgba(238,233,223,.42);
        font-family:Georgia,"Times New Roman",serif;
        font-size:9px;
        letter-spacing:.18em;
      }
      .home-v3-cover-inner{
        position:relative;
        z-index:1;
        display:flex;
        flex-direction:column;
        justify-content:flex-end;
        min-height:calc(100svh - 64px);
        padding-top:110px;
        padding-bottom:42px;
      }
      .home-v3-cover-copy h1{
        margin:0;
        font-family:Georgia,"Times New Roman",serif;
        font-size:clamp(72px,13vw,122px);
        font-weight:400;
        line-height:.80;
        letter-spacing:-.035em;
      }
      .home-v3-cover-copy h1 span{display:block}
      .home-v3-cover-copy p{
        margin:34px 0 0;
        font-size:clamp(20px,3.4vw,30px);
        letter-spacing:.08em;
      }
      .home-v3-scroll{
        display:flex;
        align-items:center;
        gap:12px;
        margin-top:52px;
        color:rgba(238,233,223,.62);
        font-family:Georgia,"Times New Roman",serif;
        font-size:9px;
        letter-spacing:.16em;
      }
      .home-v3-scroll b{font-size:17px;font-weight:400;letter-spacing:0}
      .home-v3-intro{
        padding:70px 0 82px;
        border-bottom:1px solid var(--ink);
      }
      .home-v3-intro small{
        display:block;
        margin-bottom:28px;
        color:var(--soft);
        font-family:Georgia,"Times New Roman",serif;
        font-size:10px;
        letter-spacing:.16em;
      }
      .home-v3-intro p{
        margin:0;
        max-width:18em;
        font-size:clamp(24px,4.2vw,36px);
        line-height:1.72;
        letter-spacing:.015em;
      }
      .home-v3-history-band{
        border-bottom:1px solid var(--ink);
        background:#ebe4d8;
      }
      .home-v3-history{
        display:grid;
        grid-template-columns:54px minmax(0,1fr) auto;
        gap:24px;
        align-items:end;
        min-height:310px;
        padding:58px 0 48px;
        color:inherit;
        text-decoration:none;
      }
      .home-v3-no{
        align-self:start;
        color:var(--soft);
        font-family:Georgia,"Times New Roman",serif;
        font-size:11px;
        letter-spacing:.12em;
      }
      .home-v3-history small,
      .home-v3-secondary small{
        color:var(--soft);
        font-family:Georgia,"Times New Roman",serif;
        font-size:10px;
        letter-spacing:.16em;
      }
      .home-v3-history h2{
        margin:8px 0 28px;
        font-size:clamp(48px,8vw,78px);
        line-height:.9;
        letter-spacing:-.02em;
      }
      .home-v3-history p{
        margin:0;
        color:var(--soft);
        font-size:16px;
        line-height:1.75;
      }
      .home-v3-history>b,
      .home-v3-secondary b{
        font-family:Georgia,"Times New Roman",serif;
        font-size:26px;
        font-weight:400;
      }
      .home-v3-secondary{padding:0 0 74px}
      .home-v3-secondary>a{
        display:grid;
        grid-template-columns:54px minmax(0,1fr) auto;
        gap:24px;
        align-items:center;
        min-height:112px;
        border-bottom:1px solid var(--ink);
        text-decoration:none;
      }
      .home-v3-secondary p{
        margin:5px 0 0;
        color:var(--soft);
        font-size:14px;
        line-height:1.55;
      }

      @media(max-width:480px){
        .home-v3-cover{min-height:calc(100svh - 56px)}
        .home-v3-photo-placeholder>span{top:18px;font-size:7px}
        .home-v3-cover-inner{
          min-height:calc(100svh - 56px);
          padding-top:82px;
          padding-bottom:32px;
        }
        .home-v3-cover-copy h1{
          font-size:clamp(60px,18vw,76px);
          line-height:.82;
        }
        .home-v3-cover-copy p{
          margin-top:25px;
          font-size:19px;
        }
        .home-v3-scroll{margin-top:38px}
        .home-v3-intro{padding:52px 0 60px}
        .home-v3-intro small{
          margin-bottom:22px;
          font-size:8px;
          letter-spacing:.13em;
        }
        .home-v3-intro p{
          font-size:clamp(22px,6vw,27px);
          line-height:1.72;
        }
        .home-v3-history{
          grid-template-columns:34px minmax(0,1fr) auto;
          gap:12px;
          min-height:250px;
          padding:42px 0 38px;
        }
        .home-v3-history h2{
          margin:8px 0 22px;
          font-size:clamp(46px,14vw,59px);
        }
        .home-v3-history p{
          max-width:19em;
          font-size:14px;
          line-height:1.65;
        }
        .home-v3-secondary{padding-bottom:58px}
        .home-v3-secondary>a{
          grid-template-columns:34px minmax(0,1fr) auto;
          gap:12px;
          min-height:94px;
        }
        .home-v3-secondary p{font-size:13px}
      }

      @media(max-width:340px){
        .home-v3-cover-copy h1{font-size:58px}
        .home-v3-cover-copy p{font-size:18px}
        .home-v3-intro p{font-size:21px}
        .home-v3-history h2{font-size:44px}
      }
    </style>

    <style is:global>
      .home-v3 .section-mast{
        background:#171410;
        color:#c9c1b5;
      }
      .home-v3 .section-mast .mast-link{display:none}
      .home-v3 .section-mast .section-menu>summary::before{
        border-color:rgba(238,233,223,.34);
      }
      @media(max-width:480px){
        .home-v3 .section-mast{
          font-size:8px;
          letter-spacing:.08em;
        }
      }
    </style>
  </body>
</html>
