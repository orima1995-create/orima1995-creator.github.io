---
import SeoHead from '../components/SeoHead.astro';
import '../styles/site.css';
const base = import.meta.env.BASE_URL;
const title = 'VINTAGE ALARM｜機械式アラーム腕時計の歴史・実機・資料';
const description = '機械式アラーム腕時計を、歴史・実機・音・資料から読むオンライン誌。Pierce Duofonをはじめ、各時代のアラーム腕時計と機構を整理する。';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VINTAGE ALARM',
  url: 'https://orima1995-create.github.io/orima1995-creator.github.io/',
  description,
  inLanguage: 'ja'
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <SeoHead title={title} description={description} path="" schema={schema} />
    <style is:inline>
      .home-mast-left{display:flex;align-items:center;gap:12px}
      .home-menu{position:relative;border:0!important}
      .home-menu:last-child{border-bottom:0!important}
      .home-menu>summary{display:grid;place-items:center;width:30px;height:30px;min-height:0;padding:0;border:1px solid var(--rule);font-family:sans-serif;font-size:18px;line-height:1;letter-spacing:0;cursor:pointer}
      .home-menu>summary::after{content:none!important}
      .home-menu-panel{position:absolute;z-index:20;top:38px;left:0;width:min(78vw,280px);padding:9px;border:1px solid var(--ink);background:var(--paper);box-shadow:0 16px 38px rgba(36,31,26,.14)}
      .home-menu-panel a{display:flex;justify-content:space-between;gap:18px;padding:13px 11px;border-bottom:1px solid var(--rule);color:var(--ink);font-size:13px;letter-spacing:.04em;text-decoration:none;white-space:normal}
      .home-menu-panel a:last-child{border-bottom:0}
      .home-menu-panel a::after{content:'→';font-family:Georgia,"Times New Roman",serif}
      @media(max-width:480px){
        .home-mast-left{gap:9px}
        .home-menu>summary{width:28px;height:28px;font-size:17px}
        .home-menu-panel{top:35px;width:min(84vw,280px)}
      }
    </style>
  </head>
  <body>
    <header class="shell mast">
      <div class="home-mast-left">
        <details class="home-menu">
          <summary aria-label="セクションメニュー">≡</summary>
          <nav class="home-menu-panel" aria-label="VINTAGE ALARM セクションメニュー">
            <a href={`${base}history/`}>歴史</a>
            <a href={`${base}history/#index-milestones`}>マイルストーン</a>
            <a href={`${base}history/#index-owners`}>オーナーズノート</a>
            <a href={`${base}history/#index-interests`}>調査個体</a>
          </nav>
        </details>
        <span>VINTAGE ALARM</span>
      </div>
      <span>ALARM WRISTWATCHES</span>
    </header>
    <main>
      <section class="shell home-hero">
        <h1><span>VINTAGE</span><span>ALARM</span></h1>
        <p>アラームを、腕へ。</p>
      </section>

      <nav class="shell home-nav" aria-label="VINTAGE ALARM メインコンテンツ">
        <a href={`${base}history/`}>
          <span class="home-no">01</span>
          <div><strong>HISTORY</strong><small>鐘から現在まで。アラーム腕時計の歴史を読む</small></div>
          <b>→</b>
        </a>

        <a href={`${base}history/#index-milestones`}>
          <span class="home-no">02</span>
          <div><strong>MILESTONES</strong><small>歴史の節目になったアラーム腕時計</small></div>
          <b>→</b>
        </a>

        <a href={`${base}history/#index-owners`}>
          <span class="home-no">03</span>
          <div><strong>OWNER'S NOTES</strong><small>所有個体を、実機・操作・音から読む</small></div>
          <b>→</b>
        </a>

        <a href={`${base}history/#index-interests`}>
          <span class="home-no">04</span>
          <div><strong>RESEARCH</strong><small>気になっているもの、調査中の個体</small></div>
          <b>→</b>
        </a>
      </nav>
    </main>
  </body>
</html>
