---
import SeoHead from '../components/SeoHead.astro';
import '../styles/site.css';
const base = import.meta.env.BASE_URL;
const title = 'VINTAGE ALARM｜機械式アラーム腕時計の歴史・実機・資料';
const description = '機械式アラーム腕時計を、歴史・実機・音・資料から読むオンライン誌。Pierce Duofonをはじめ、各時代のアラーム腕時計と機構を整理する。';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VINTAGE ALARM',
  url: 'https://orima1995-create.github.io/orima1995-creator.github.io/',
  description,
  inLanguage: 'ja'
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <SeoHead title={title} description={description} path="" schema={schema} />
  </head>
  <body>
    <header class="shell mast"><span>VINTAGE ALARM</span><span>ALARM WRISTWATCHES</span></header>
    <main>
      <section class="shell home-hero">
        <h1><span>VINTAGE</span><span>ALARM</span></h1>
        <p>アラームを、腕へ。</p>
      </section>

      <nav class="shell home-nav" aria-label="VINTAGE ALARM メインコンテンツ">
        <a href={`${base}history/`}>
          <span class="home-no">01</span>
          <div><strong>HISTORY</strong><small>アラーム腕時計は、どうやって腕に載った？</small></div>
          <b>→</b>
        </a>

        <div class="home-nav-disabled" aria-disabled="true">
          <span class="home-no">02</span>
          <div><strong>THEMES</strong><small>音・防水・香箱・通知</small></div>
          <em>準備中</em>
        </div>

        <a href={`${base}pierce-duofon/`}>
          <span class="home-no">03</span>
          <div><strong>OWNER'S NOTES</strong><small>実機・操作・音から読む</small></div>
          <b>→</b>
        </a>
      </nav>
    </main>
  </body>
</html>
